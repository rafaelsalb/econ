{"type":"tool_use","timestamp":1795491149891,"sessionID":"ses_df463e6c2ffeJIQ0xCaosxh4r8","part":{"partID":"prt_20b9cb6e9002ZuRWJmaizQDJHz","sessionID":"ses_df463e6c2ffeJIQ0xCaosxh4r8","messageID":"msg_20b9ca4b10014sSvn3lkNMLsar","type":"tool","id":"call_e28c300ee55248598fe2f347","tool":"read","state":{"status":"completed","input":{"path":"/workspace/in/src/loop.py"},"output":"Read file /workspace/in/src/loop.py, lines 1-353\n1: from __future__ import annotations\n2: \n3: import json\n4: from dataclasses import asdict\n5: from datetime import date\n6: from pathlib import Path\n7: \n8: import pandas as pd\n9: \n10: from . import config\n11: from .backtest import run_backtest\n12: from .critics import adequacy_critique, fidelity_critique\n13: from .diagnostics import Defect, fit_diagnostics, forecast_sanity, irf_signs, stability\n14: from .evaluate import evaluate\n15: from .ingest import load_observations\n16: from .models.new_keynesian import NewKeynesian\n17: from .specs import hash_card, load_card, validate_card\n18: from .vintage import Panel\n19: \n20: VARIANTS = [\"R1\", \"R2\", \"R3\"]\n21: DIAG_ORIGINS = [date(2015, 12, 31), date(2019, 12, 31)]\n22: \n23: REVISION_TEXT = {\n24:     \"R2\": (\n25:         \"Replace the gap-implied IBC-Br path in the GDP satellite bridge with an \"\n26:         \"AR(1) path on monthly IBC-Br growth. The structural inflation and policy \"\n27:         \"block is unchanged. Hypothesis: the GDP defect is a mapping defect, not an \"\n28:         \"inflation-block defect.\"\n29:     ),\n30:     \"R3\": (\n31:         \"Replace lagged 12-month inflation in the Taylor rule with the Focus 12-month \"\n32:         \"expectation, making the policy rule forward-looking. Keeps R2. Hypothesis: \"\n33:         \"the Selic defect is a policy-response timing defect.\"\n34:     ),\n35: }\n36: \n37: \n38: def _decide(defects: list[Defect], round_no: int, max_rounds: int) -> dict:\n39:     high = [d for d in defects if d.severity == \"high\"]\n40:     core = [d for d in defects if d.code == \"D5\" and d.evidence.get(\"target\") == \"ipca_12m\"]\n41:     aux = [\n42:         d\n43:         for d in defects\n44:         if d.code == \"D5\" and d.evidence.get(\"target\") in {\"gdp_qq\", \"selic\"}\n45:     ]\n46:     medium = [d for d in defects if d.severity == \"medium\"]\n47: \n48:     if high:\n49:         return {\n50:             \"status\": \"REVISE\" if round_no < max_rounds else \"REJECTED\",\n51:             \"reason\": \"high-severity defects remain\",\n52:             \"blocking\": [d.to_dict() for d in high],\n53:             \"next\": None,\n54:         }\n55:     if core:\n56:         return {\n57:             \"status\": \"REVISE\" if round_no < max_rounds else \"REJECTED\",\n58:             \"reason\": \"core inflation target fails\",\n59:             \"blocking\": [d.to_dict() for d in core],\n60:             \"next\": None,\n61:         }\n62:     if aux:\n63:         if round_no < max_rounds:\n64:             targets = {d.evidence.get(\"target\") for d in aux}\n65:             next_variant = \"R2\" if \"gdp_qq\" in targets else \"R3\"\n66:             return {\n67:                 \"status\": \"REVISE\",\n68:                 \"reason\": f\"auxiliary target defect: {sorted(targets)}\",\n69:                 \"blocking\": [d.to_dict() for d in aux],\n70:                 \"next\": next_variant,\n71:             }\n72:         return {\n73:             \"status\": \"PASS_WITH_LIMITATIONS\",\n74:             \"reason\": \"core inflation passes; auxiliary target limitations remain after the ladder\",\n75:             \"blocking\": [d.to_dict() for d in aux],\n76:             \"next\": None,\n77:         }\n78:     if medium:\n79:         return {\n80:             \"status\": \"PASS_WITH_LIMITATIONS\",\n81:             \"reason\": \"core and auxiliary gates pass; medium-severity limitations recorded\",\n82:             \"limitations\": [d.to_dict() for d in medium],\n83:             \"next\": None,\n84:         }\n85:     return {\"status\": \"PASS\", \"reason\": \"all gates pass\", \"next\": None}\n86: \n87: \n88: def _modeler_view(defects: list[Defect]) -> list[dict]:\n89:     \"\"\"Typed defects without numeric validation scores (binary gate, not gradient).\"\"\"\n90:     out = []\n91:     for d in defects:\n92:         dd = d.to_dict()\n93:         if dd[\"code\"] == \"D5\":\n94:             ev = dd.get(\"evidence\", {})\n95:             dd[\"evidence\"] = {\n96:                 \"target\": ev.get(\"target\"),\n97:                 \"horizon\": ev.get(\"horizon\"),\n98:                 \"gate\": \"fail\",\n99:             }\n100:             dd[\"message\"] = (\n101:                 f\"{ev.get('target')} h={ev.get('horizon')} fails the forecast gate\"\n102:             )\n103:         out.append(dd)\n104:     return out\n105: \n106: \n107: def _packets(out: Path, card: dict, card_hash: str, round_no: int, variant: str,\n108:              defects: list[Defect], decision: dict) -> None:\n109:     out.mkdir(parents=True, exist_ok=True)\n110:     blind = [d.to_dict() for d in defects]\n111:     modeler = _modeler_view(defects)\n112:     (out / \"critic_packet.md\").write_text(\n113:         \"# Blind critic packet\\n\\n\"\n114:         f\"Model card hash: `{card_hash}`\\n\\n\"\n115:         f\"Round: {round_no} · variant: {variant}\\n\\n\"\n116:         \"You see only the frozen card, the code, and the diagnostics. You do not see \"\n117:         \"the modeler's rationale or the validation score table.\\n\\n\"\n118:         \"## Typed defects\\n\\n```json\\n\"\n119:         + json.dumps(blind, indent=2)\n120:         + \"\\n```\\n\"\n121:     )\n122:     (out / \"modeler_packet.md\").write_text(\n123:         \"# Modeler packet\\n\\n\"\n124:         f\"Round: {round_no} · variant: {variant}\\n\\n\"\n125:         \"You receive typed defects only, with no numeric validation scores. You may \"\n126:         \"apply one revision from the pre-registered ladder in the card; you may not \"\n127:         \"add variables or change the estimation sample.\\n\\n\"\n128:         \"## Defects\\n\\n```json\\n\"\n129:         + json.dumps(modeler, indent=2)\n130:         + \"\\n```\\n\"\n131:     )\n132:     (out / \"theorist_packet.md\").write_text(\n133:         \"# Theorist packet\\n\\n\"\n134:         f\"Frozen card: `specs/{card['model_id']}.yaml` (sha256 `{card_hash}`)\\n\\n\"\n135:         f\"Round {round_no} decision: **{decision['status']}** — {decision.get('reason','')}\\n\\n\"\n136:         \"If the loop continues, the only admissible revision is the next rung of the \"\n137:         \"pre-registered ladder. The card itself is not editable inside the loop.\\n\"\n138:     )\n139: \n140: \n141: def _run_advisory(\n142:     model_id: str,\n143:     card: dict,\n144:     card_hash: str,\n145:     out: Path,\n146:     defects: list[Defect],\n147:     nk_metrics: pd.DataFrame,\n148:     run_id: str,\n149:     round_no: int,\n150:     variant: str,\n151: ) -> list[dict]:\n152:     \"\"\"Run the sandboxed LLM critics. Advisory only: the mechanical gate decides.\"\"\"\n153:     from .sandbox import run_agent\n154: \n155:     gate = []\n156:     for _, row in nk_metrics[nk_metrics[\"primary\"]].iterrows():\n157:         passed = bool(\n158:             pd.notna(row[\"theil_u\"])\n159:             and row[\"theil_u\"] <= 1.05\n160:             and pd.notna(row[\"mz_slope_p\"])\n161:             and row[\"mz_slope_p\"] >= 0.05\n162:         )\n163:         gate.append(\n164:             {\n165:                 \"target\": row[\"target\"],\n166:                 \"horizon\": int(row[\"horizon\"]),\n167:                 \"pass\": passed,\n168:             }\n169:         )\n170:     advisory_dir = out / \"advisory\"\n171:     advisory_dir.mkdir(parents=True, exist_ok=True)\n172:     (advisory_dir / \"metrics_gate.json\").write_text(json.dumps(gate, indent=2))\n173: \n174:     packet = (\n175:         f\"# Advisory critic packet — round {round_no}\\n\\n\"\n176:         f\"Model: {model_id} · variant: {variant} · card hash: `{card_hash}`\\n\\n\"\n177:         \"The mechanical gate is authoritative. Your role is advisory: return \"\n178:         \"typed defects and a recommendation, but do not claim to grant PASS.\\n\\n\"\n179:         \"Files in /workspace/in: spec.yaml, defects.json, diagnostics.json, \"\n180:         \"metrics_gate.json (pass/fail only), src/ (code snapshot).\\n\"\n181:     )\n182:     inputs = {\n183:         \"spec.yaml\": config.SPECS / f\"{model_id}.yaml\",\n184:         \"defects.json\": out / \"defects.json\",\n185:         \"diagnostics.json\": out / \"diagnostics.json\",\n186:         \"metrics_gate.json\": advisory_dir / \"metrics_gate.json\",\n187:         \"src\": config.ROOT / \"src\" / \"econ\",\n188:     }\n189: \n190:     results = []\n191:     for role in [\"critic_fidelity\", \"critic_adequacy\"]:\n192:         record = {\"role\": role, \"status\": \"skipped\"}\n193:         try:\n194:             res = run_agent(\n195:                 role,\n196:                 f\"{run_id}-r{round_no}\",\n197:                 inputs=inputs,\n198:                 packet=packet,\n199:             )\n200:             result_file = res.workspace.outbox / \"result.json\"\n201:             if res.exit_code == 0 and result_file.exists():\n202:                 payload = json.loads(result_file.read_text())\n203:                 (advisory_dir / f\"{role}.json\").write_text(\n204:                     json.dumps(payload, indent=2)\n205:                 )\n206:                 record.update(\n207:                     {\n208:                         \"status\": \"ok\",\n209:                         \"exit_code\": res.exit_code,\n210:                         \"audit\": str(res.audit_path),\n211:                         \"n_defects\": len(payload.get(\"defects\", [])),\n212:                     }\n213:                 )\n214:             else:\n215:                 record.update(\n216:                     {\n217:                         \"status\": \"error\",\n218:                         \"exit_code\": res.exit_code,\n219:                         \"audit\": str(res.audit_path),\n220:                         \"stderr_tail\": res.stderr()[-800:],\n221:                     }\n222:                 )\n223:         except Exception as exc:  # noqa: BLE001\n224:             record.update({\"status\": \"skipped\", \"error\": f\"{type(exc).__name__}: {exc}\"})\n225:         results.append(record)\n226:         print(f\"  advisory {role}: {record['status']}\")\n227:     (advisory_dir / \"summary.json\").write_text(json.dumps(results, indent=2))\n228:     return results\n229: \n230: \n231: def run_loop(\n232:     model_id: str = \"new_keynesian\",\n233:     start: date = date.fromisoformat(config.VALIDATION_START),\n234:     end: date = date.fromisoformat(config.VALIDATION_END),\n235:     max_rounds: int = 3,\n236:     agents: bool = False,\n237: ) -> dict:\n238:     card = load_card(model_id)\n239:     problems = validate_card(card)\n240:     if problems:\n241:         raise ValueError(f\"invalid card: {problems}\")\n242:     card_hash = hash_card(model_id)\n243: \n244:     obs = load_observations()\n245:     loop_dir = config.RUNS / \"loop\" / model_id\n246:     loop_dir.mkdir(parents=True, exist_ok=True)\n247:     history = []\n248:     final = None\n249: \n250:     for round_no, variant in enumerate(VARIANTS[:max_rounds], start=1):\n251:         print(f\"loop round {round_no}: {variant}\")\n252:         ctx, fc = run_backtest(\n253:             [\"random_walk\", \"focus_consensus\", model_id],\n254:             start,\n255:             end,\n256:             model_kwargs={model_id: {\"variant\": variant}},\n257:         )\n258:         metrics = evaluate(fc[fc[\"run_id\"] == ctx.run_id], obs)\n259:         nk_metrics = metrics[metrics[\"model_id\"] == model_id]\n260: \n261:         diags = {str(o): fit_diagnostics(Panel.build(o, obs), variant) for o in DIAG_ORIGINS}\n262:         diag_late = diags[str(DIAG_ORIGINS[-1])]\n263:         stab = stability(diags[str(DIAG_ORIGINS[0])], diag_late)\n264:         irf = irf_signs(diag_late[\"params\"])\n265: \n266:         sanity_rows = NewKeynesian(variant=variant).forecast(Panel.build(DIAG_ORIGINS[-1], obs))\n267:         sanity = forecast_sanity(sanity_rows)\n268: \n269:         defects = fidelity_critique(diag_late, irf, card)\n270:         defects += adequacy_critique(diag_late, nk_metrics, stab, card=card)\n271:         if not all(v[\"in_range\"] for v in sanity.values()):\n272:             defects.append(\n273:                 Defect(\"D6\", \"high\", \"Forecast path outside admissible range\", {\"sanity\": sanity})\n274:             )\n275: \n276:         decision = _decide(defects, round_no, max_rounds)\n277:         out = loop_dir / f\"round-{round_no}\"\n278:         _packets(out, card, card_hash, round_no, variant, defects, decision)\n279:         (out / \"diagnostics.json\").write_text(\n280:             json.dumps({\"late\": diag_late, \"stability\": stab, \"irf\": irf, \"sanity\": sanity}, indent=2)\n281:         )\n282:         (out / \"defects.json\").write_text(json.dumps([d.to_dict() for d in defects], indent=2))\n283:         # The score table is stored for the human, not passed to the modeler packet.\n284:         nk_metrics.to_csv(out / \"metrics.csv\", index=False)\n285:         (out / \"decision.json\").write_text(json.dumps(decision, indent=2))\n286: \n287:         advisory: list[dict] = []\n288:         if agents:\n289:             advisory = _run_advisory(\n290:                 model_id,\n291:                 card,\n292:                 card_hash,\n293:                 out,\n294:                 defects,\n295:                 nk_metrics,\n296:                 ctx.run_id,\n297:                 round_no,\n298:                 variant,\n299:             )\n300: \n301:         entry = {\n302:             \"round\": round_no,\n303:             \"variant\": variant,\n304:             \"run_id\": ctx.run_id,\n305:             \"status\": decision[\"status\"],\n306:             \"reason\": decision.get(\"reason\"),\n307:             \"n_high\": sum(d.severity == \"high\" for d in defects),\n308:             \"n_medium\": sum(d.severity == \"medium\" for d in defects),\n309:             \"defect_codes\": sorted({d.code for d in defects}),\n310:             \"core\": nk_metrics[\n311:                 (nk_metrics[\"target\"] == \"ipca_12m\")\n312:                 & (nk_metrics[\"horizon\"].isin([6, 12]))\n313:             ][[\"horizon\", \"theil_u\", \"mz_slope_p\"]].to_dict(orient=\"records\"),\n314:             \"advisory\": advisory,\n315:         }\n316:         history.append(entry)\n317:         final = {**decision, \"round\": round_no, \"variant\": variant, \"run_id\": ctx.run_id}\n318: \n319:         if decision[\"status\"] in {\"PASS\", \"PASS_WITH_LIMITATIONS\", \"REJECTED\", \"UNESTIMABLE\", \"UNRESOLVED\"}:\n320:             break\n321:         if decision[\"status\"] == \"REVISE\" and not decision.get(\"next\"):\n322:             final = {\n323:                 **decision,\n324:                 \"status\": \"REJECTED\",\n325:                 \"round\": round_no,\n326:                 \"variant\": variant,\n327:                 \"run_id\": ctx.run_id,\n328:                 \"reason\": decision.get(\"reason\", \"\") + \"; no admissible revision targets the blocking defect\",\n329:             }\n330:             break\n331:         if decision.get(\"next\"):\n332:             (out / \"revision.json\").write_text(\n333:                 json.dumps(\n334:                     {\n335:                         \"next_round\": round_no + 1,\n336:                         \"applied\": decision[\"next\"],\n337:                         \"hypothesis\": REVISION_TEXT.get(decision[\"next\"], \"\"),\n338:                     },\n339:                     indent=2,\n340:                 )\n341:             )\n342: \n343:     result = {\n344:         \"model_id\": model_id,\n345:         \"card_hash\": card_hash,\n346:         \"validation_window\": [str(start), str(end)],\n347:         \"max_rounds\": max_rounds,\n348:         \"history\": history,\n349:         \"terminal\": final,\n350:     }\n351:     (loop_dir / \"decision.json\").write_text(json.dumps(result, indent=2))\n352:     (config.SPECS / f\"{model_id}.decision.json\").write_text(json.dumps(result, indent=2))\n353:     return result","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /workspace/in/src/loop.py, lines 1-353\n1: from __future__ import annotations\n2: \n3: import json\n4: from dataclasses import asdict\n5: from datetime import date\n6: from pathlib import Path\n7: \n8: import pandas as pd\n9: \n10: from . import config\n11: from .backtest import run_backtest\n12: from .critics import adequacy_critique, fidelity_critique\n13: from .diagnostics import Defect, fit_diagnostics, forecast_sanity, irf_signs, stability\n14: from .evaluate import evaluate\n15: from .ingest import load_observations\n16: from .models.new_keynesian import NewKeynesian\n17: from .specs import hash_card, load_card, validate_card\n18: from .vintage import Panel\n19: \n20: VARIANTS = [\"R1\", \"R2\", \"R3\"]\n21: DIAG_ORIGINS = [date(2015, 12, 31), date(2019, 12, 31)]\n22: \n23: REVISION_TEXT = {\n24:     \"R2\": (\n25:         \"Replace the gap-implied IBC-Br path in the GDP satellite bridge with an \"\n26:         \"AR(1) path on monthly IBC-Br growth. The structural inflation and policy \"\n27:         \"block is unchanged. Hypothesis: the GDP defect is a mapping defect, not an \"\n28:         \"inflation-block defect.\"\n29:     ),\n30:     \"R3\": (\n31:         \"Replace lagged 12-month inflation in the Taylor rule with the Focus 12-month \"\n32:         \"expectation, making the policy rule forward-looking. Keeps R2. Hypothesis: \"\n33:         \"the Selic defect is a policy-response timing defect.\"\n34:     ),\n35: }\n36: \n37: \n38: def _decide(defects: list[Defect], round_no: int, max_rounds: int) -> dict:\n39:     high = [d for d in defects if d.severity == \"high\"]\n40:     core = [d for d in defects if d.code == \"D5\" and d.evidence.get(\"target\") == \"ipca_12m\"]\n41:     aux = [\n42:         d\n43:         for d in defects\n44:         if d.code == \"D5\" and d.evidence.get(\"target\") in {\"gdp_qq\", \"selic\"}\n45:     ]\n46:     medium = [d for d in defects if d.severity == \"medium\"]\n47: \n48:     if high:\n49:         return {\n50:             \"status\": \"REVISE\" if round_no < max_rounds else \"REJECTED\",\n51:             \"reason\": \"high-severity defects remain\",\n52:             \"blocking\": [d.to_dict() for d in high],\n53:             \"next\": None,\n54:         }\n55:     if core:\n56:         return {\n57:             \"status\": \"REVISE\" if round_no < max_rounds else \"REJECTED\",\n58:             \"reason\": \"core inflation target fails\",\n59:             \"blocking\": [d.to_dict() for d in core],\n60:             \"next\": None,\n61:         }\n62:     if aux:\n63:         if round_no < max_rounds:\n64:             targets = {d.evidence.get(\"target\") for d in aux}\n65:             next_variant = \"R2\" if \"gdp_qq\" in targets else \"R3\"\n66:             return {\n67:                 \"status\": \"REVISE\",\n68:                 \"reason\": f\"auxiliary target defect: {sorted(targets)}\",\n69:                 \"blocking\": [d.to_dict() for d in aux],\n70:                 \"next\": next_variant,\n71:             }\n72:         return {\n73:             \"status\": \"PASS_WITH_LIMITATIONS\",\n74:             \"reason\": \"core inflation passes; auxiliary target limitations remain after the ladder\",\n75:             \"blocking\": [d.to_dict() for d in aux],\n76:             \"next\": None,\n77:         }\n78:     if medium:\n79:         return {\n80:             \"status\": \"PASS_WITH_LIMITATIONS\",\n81:             \"reason\": \"core and auxiliary gates pass; medium-severity limitations recorded\",\n82:             \"limitations\": [d.to_dict() for d in medium],\n83:             \"next\": None,\n84:         }\n85:     return {\"status\": \"PASS\", \"reason\": \"all gates pass\", \"next\": None}\n86: \n87: \n88: def _modeler_view(defects: list[Defect]) -> list[dict]:\n89:     \"\"\"Typed defects without numeric validation scores (binary gate, not gradient).\"\"\"\n90:     out = []\n91:     for d in defects:\n92:         dd = d.to_dict()\n93:         if dd[\"code\"] == \"D5\":\n94:             ev = dd.get(\"evidence\", {})\n95:             dd[\"evidence\"] = {\n96:                 \"target\": ev.get(\"target\"),\n97:                 \"horizon\": ev.get(\"horizon\"),\n98:                 \"gate\": \"fail\",\n99:             }\n100:             dd[\"message\"] = (\n101:                 f\"{ev.get('target')} h={ev.get('horizon')} fails the forecast gate\"\n102:             )\n103:         out.append(dd)\n104:     return out\n105: \n106: \n107: def _packets(out: Path, card: dict, card_hash: str, round_no: int, variant: str,\n108:              defects: list[Defect], decision: dict) -> None:\n109:     out.mkdir(parents=True, exist_ok=True)\n110:     blind = [d.to_dict() for d in defects]\n111:     modeler = _modeler_view(defects)\n112:     (out / \"critic_packet.md\").write_text(\n113:         \"# Blind critic packet\\n\\n\"\n114:         f\"Model card hash: `{card_hash}`\\n\\n\"\n115:         f\"Round: {round_no} · variant: {variant}\\n\\n\"\n116:         \"You see only the frozen card, the code, and the diagnostics. You do not see \"\n117:         \"the modeler's rationale or the validation score table.\\n\\n\"\n118:         \"## Typed defects\\n\\n```json\\n\"\n119:         + json.dumps(blind, indent=2)\n120:         + \"\\n```\\n\"\n121:     )\n122:     (out / \"modeler_packet.md\").write_text(\n123:         \"# Modeler packet\\n\\n\"\n124:         f\"Round: {round_no} · variant: {variant}\\n\\n\"\n125:         \"You receive typed defects only, with no numeric validation scores. You may \"\n126:         \"apply one revision from the pre-registered ladder in the card; you may not \"\n127:         \"add variables or change the estimation sample.\\n\\n\"\n128:         \"## Defects\\n\\n```json\\n\"\n129:         + json.dumps(modeler, indent=2)\n130:         + \"\\n```\\n\"\n131:     )\n132:     (out / \"theorist_packet.md\").write_text(\n133:         \"# Theorist packet\\n\\n\"\n134:         f\"Frozen card: `specs/{card['model_id']}.yaml` (sha256 `{card_hash}`)\\n\\n\"\n135:         f\"Round {round_no} decision: **{decision['status']}** — {decision.get('reason','')}\\n\\n\"\n136:         \"If the loop continues, the only admissible revision is the next rung of the \"\n137:         \"pre-registered ladder. The card itself is not editable inside the loop.\\n\"\n138:     )\n139: \n140: \n141: def _run_advisory(\n142:     model_id: str,\n143:     card: dict,\n144:     card_hash: str,\n145:     out: Path,\n146:     defects: list[Defect],\n147:     nk_metrics: pd.DataFrame,\n148:     run_id: str,\n149:     round_no: int,\n150:     variant: str,\n151: ) -> list[dict]:\n152:     \"\"\"Run the sandboxed LLM critics. Advisory only: the mechanical gate decides.\"\"\"\n153:     from .sandbox import run_agent\n154: \n155:     gate = []\n156:     for _, row in nk_metrics[nk_metrics[\"primary\"]].iterrows():\n157:         passed = bool(\n158:             pd.notna(row[\"theil_u\"])\n159:             and row[\"theil_u\"] <= 1.05\n160:             and pd.notna(row[\"mz_slope_p\"])\n161:             and row[\"mz_slope_p\"] >= 0.05\n162:         )\n163:         gate.append(\n164:             {\n165:                 \"target\": row[\"target\"],\n166:                 \"horizon\": int(row[\"horizon\"]),\n167:                 \"pass\": passed,\n168:             }\n169:         )\n170:     advisory_dir = out / \"advisory\"\n171:     advisory_dir.mkdir(parents=True, exist_ok=True)\n172:     (advisory_dir / \"metrics_gate.json\").write_text(json.dumps(gate, indent=2))\n173: \n174:     packet = (\n175:         f\"# Advisory critic packet — round {round_no}\\n\\n\"\n176:         f\"Model: {model_id} · variant: {variant} · card hash: `{card_hash}`\\n\\n\"\n177:         \"The mechanical gate is authoritative. Your role is advisory: return \"\n178:         \"typed defects and a recommendation, but do not claim to grant PASS.\\n\\n\"\n179:         \"Files in /workspace/in: spec.yaml, defects.json, diagnostics.json, \"\n180:         \"metrics_gate.json (pass/fail only), src/ (code snapshot).\\n\"\n181:     )\n182:     inputs = {\n183:         \"spec.yaml\": config.SPECS / f\"{model_id}.yaml\",\n184:         \"defects.json\": out / \"defects.json\",\n185:         \"diagnostics.json\": out / \"diagnostics.json\",\n186:         \"metrics_gate.json\": advisory_dir / \"metrics_gate.json\",\n187:         \"src\": config.ROOT / \"src\" / \"econ\",\n188:     }\n189: \n190:     results = []\n191:     for role in [\"critic_fidelity\", \"critic_adequacy\"]:\n192:         record = {\"role\": role, \"status\": \"skipped\"}\n193:         try:\n194:             res = run_agent(\n195:                 role,\n196:                 f\"{run_id}-r{round_no}\",\n197:                 inputs=inputs,\n198:                 packet=packet,\n199:             )\n200:             result_file = res.workspace.outbox / \"result.json\"\n201:             if res.exit_code == 0 and result_file.exists():\n202:                 payload = json.loads(result_file.read_text())\n203:                 (advisory_dir / f\"{role}.json\").write_text(\n204:                     json.dumps(payload, indent=2)\n205:                 )\n206:                 record.update(\n207:                     {\n208:                         \"status\": \"ok\",\n209:                         \"exit_code\": res.exit_code,\n210:                         \"audit\": str(res.audit_path),\n211:                         \"n_defects\": len(payload.get(\"defects\", [])),\n212:                     }\n213:                 )\n214:             else:\n215:                 record.update(\n216:                     {\n217:                         \"status\": \"error\",\n218:                         \"exit_code\": res.exit_code,\n219:                         \"audit\": str(res.audit_path),\n220:                         \"stderr_tail\": res.stderr()[-800:],\n221:                     }\n222:                 )\n223:         except Exception as exc:  # noqa: BLE001\n224:             record.update({\"status\": \"skipped\", \"error\": f\"{type(exc).__name__}: {exc}\"})\n225:         results.append(record)\n226:         print(f\"  advisory {role}: {record['status']}\")\n227:     (advisory_dir / \"summary.json\").write_text(json.dumps(results, indent=2))\n228:     return results\n229: \n230: \n231: def run_loop(\n232:     model_id: str = \"new_keynesian\",\n233:     start: date = date.fromisoformat(config.VALIDATION_START),\n234:     end: date = date.fromisoformat(config.VALIDATION_END),\n235:     max_rounds: int = 3,\n236:     agents: bool = False,\n237: ) -> dict:\n238:     card = load_card(model_id)\n239:     problems = validate_card(card)\n240:     if problems:\n241:         raise ValueError(f\"invalid card: {problems}\")\n242:     card_hash = hash_card(model_id)\n243: \n244:     obs = load_observations()\n245:     loop_dir = config.RUNS / \"loop\" / model_id\n246:     loop_dir.mkdir(parents=True, exist_ok=True)\n247:     history = []\n248:     final = None\n249: \n250:     for round_no, variant in enumerate(VARIANTS[:max_rounds], start=1):\n251:         print(f\"loop round {round_no}: {variant}\")\n252:         ctx, fc = run_backtest(\n253:             [\"random_walk\", \"focus_consensus\", model_id],\n254:             start,\n255:             end,\n256:             model_kwargs={model_id: {\"variant\": variant}},\n257:         )\n258:         metrics = evaluate(fc[fc[\"run_id\"] == ctx.run_id], obs)\n259:         nk_metrics = metrics[metrics[\"model_id\"] == model_id]\n260: \n261:         diags = {str(o): fit_diagnostics(Panel.build(o, obs), variant) for o in DIAG_ORIGINS}\n262:         diag_late = diags[str(DIAG_ORIGINS[-1])]\n263:         stab = stability(diags[str(DIAG_ORIGINS[0])], diag_late)\n264:         irf = irf_signs(diag_late[\"params\"])\n265: \n266:         sanity_rows = NewKeynesian(variant=variant).forecast(Panel.build(DIAG_ORIGINS[-1], obs))\n267:         sanity = forecast_sanity(sanity_rows)\n268: \n269:         defects = fidelity_critique(diag_late, irf, card)\n270:         defects += adequacy_critique(diag_late, nk_metrics, stab, card=card)\n271:         if not all(v[\"in_range\"] for v in sanity.values()):\n272:             defects.append(\n273:                 Defect(\"D6\", \"high\", \"Forecast path outside admissible range\", {\"sanity\": sanity})\n274:             )\n275: \n276:         decision = _decide(defects, round_no, max_rounds)\n277:         out = loop_dir / f\"round-{round_no}\"\n278:         _packets(out, card, card_hash, round_no, variant, defects, decision)\n279:         (out / \"diagnostics.json\").write_text(\n280:             json.dumps({\"late\": diag_late, \"stability\": stab, \"irf\": irf, \"sanity\": sanity}, indent=2)\n281:         )\n282:         (out / \"defects.json\").write_text(json.dumps([d.to_dict() for d in defects], indent=2))\n283:         # The score table is stored for the human, not passed to the modeler packet.\n284:         nk_metrics.to_csv(out / \"metrics.csv\", index=False)\n285:         (out / \"decision.json\").write_text(json.dumps(decision, indent=2))\n286: \n287:         advisory: list[dict] = []\n288:         if agents:\n289:             advisory = _run_advisory(\n290:                 model_id,\n291:                 card,\n292:                 card_hash,\n293:                 out,\n294:                 defects,\n295:                 nk_metrics,\n296:                 ctx.run_id,\n297:                 round_no,\n298:                 variant,\n299:             )\n300: \n301:         entry = {\n302:             \"round\": round_no,\n303:             \"variant\": variant,\n304:             \"run_id\": ctx.run_id,\n305:             \"status\": decision[\"status\"],\n306:             \"reason\": decision.get(\"reason\"),\n307:             \"n_high\": sum(d.severity == \"high\" for d in defects),\n308:             \"n_medium\": sum(d.severity == \"medium\" for d in defects),\n309:             \"defect_codes\": sorted({d.code for d in defects}),\n310:             \"core\": nk_metrics[\n311:                 (nk_metrics[\"target\"] == \"ipca_12m\")\n312:                 & (nk_metrics[\"horizon\"].isin([6, 12]))\n313:             ][[\"horizon\", \"theil_u\", \"mz_slope_p\"]].to_dict(orient=\"records\"),\n314:             \"advisory\": advisory,\n315:         }\n316:         history.append(entry)\n317:         final = {**decision, \"round\": round_no, \"variant\": variant, \"run_id\": ctx.run_id}\n318: \n319:         if decision[\"status\"] in {\"PASS\", \"PASS_WITH_LIMITATIONS\", \"REJECTED\", \"UNESTIMABLE\", \"UNRESOLVED\"}:\n320:             break\n321:         if decision[\"status\"] == \"REVISE\" and not decision.get(\"next\"):\n322:             final = {\n323:                 **decision,\n324:                 \"status\": \"REJECTED\",\n325:                 \"round\": round_no,\n326:                 \"variant\": variant,\n327:                 \"run_id\": ctx.run_id,\n328:                 \"reason\": decision.get(\"reason\", \"\") + \"; no admissible revision targets the blocking defect\",\n329:             }\n330:             break\n331:         if decision.get(\"next\"):\n332:             (out / \"revision.json\").write_text(\n333:                 json.dumps(\n334:                     {\n335:                         \"next_round\": round_no + 1,\n336:                         \"applied\": decision[\"next\"],\n337:                         \"hypothesis\": REVISION_TEXT.get(decision[\"next\"], \"\"),\n338:                     },\n339:                     indent=2,\n340:                 )\n341:             )\n342: \n343:     result = {\n344:         \"model_id\": model_id,\n345:         \"card_hash\": card_hash,\n346:         \"validation_window\": [str(start), str(end)],\n347:         \"max_rounds\": max_rounds,\n348:         \"history\": history,\n349:         \"terminal\": final,\n350:     }\n351:     (loop_dir / \"decision.json\").write_text(json.dumps(result, indent=2))\n352:     (config.SPECS / f\"{model_id}.decision.json\").write_text(json.dumps(result, indent=2))\n353:     return result"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/workspace/in/src/loop.py\"}"},"time":{"start":1795491149545,"end":1795491149891}}}}
