\n43: \n44: \n45: def attach_realized(forecasts: pd.DataFrame, obs: pd.DataFrame) -> pd.DataFrame:\n46:     rt = realized_table(obs)\n47:     fc = forecasts.copy()\n48:     fc[\"ref_date\"] = pd.to_datetime(fc[\"ref_date\"]).dt.date\n49:     fc[\"origin_date\"] = pd.to_datetime(fc[\"origin_date\"]).dt.date\n50:     out = fc.merge(rt, on=[\"target\", \"ref_date\"], how=\"left\")\n51:     out[\"error\"] = out[\"point\"] - out[\"realized\"]\n52:     return out\n53: \n54: \n55: def dm_test(e1: np.ndarray, e2: np.ndarray, h: int) -> tuple[float, float]:\n56:     d = np.asarray(e1, float) ** 2 - np.asarray(e2, float) ** 2\n57:     n = len(d)\n58:     if n < 8:\n59:         return np.nan, np.nan\n60:     dbar = float(np.mean(d))\n61:     gamma0 = float(np.var(d, ddof=0))\n62:     L = max(h, 1)\n63:     var = gamma0\n64:     for j in range(1, L + 1):\n65:         if j >= n:\n66:             break\n67:         gj = float(np.mean((d[j:] - dbar) * (d[:-j] - dbar)))\n68:         var += 2.0 * (1.0 - j / (L + 1)) * gj\n69:     var /= n\n70:     if var <= 0:\n71:         return np.nan, np.nan\n72:     stat = dbar / np.sqrt(var)\n73:     if h > 0:\n74:         stat *= np.sqrt((n + 1 - 2 * h + h * (h - 1) / n) / n)\n75:     p = 2 * (1 - stats.t.cdf(abs(stat), df=n - 1))\n76:     return float(stat), float(p)\n77: \n78: \n79: def mz_test(y: np.ndarray, fc: np.ndarray, h: int) -> dict:\n80:     y = np.asarray(y, float)\n81:     fc = np.asarray(fc, float)\n82:     nan = {\n83:         \"mz_slope\": np.nan,\n84:         \"mz_slope_p\": np.nan,\n85:         \"mz_intercept\": np.nan,\n86:         \"mz_intercept_p\": np.nan,\n87:         \"mz_r2\": np.nan,\n88:     }\n89:     if len(y) < 8 or np.std(fc) < 1e-10 or np.std(y) < 1e-10:\n90:         return nan\n91:     X = sm.add_constant(fc)\n92:     if np.linalg.matrix_rank(X) < 2:\n93:         return nan\n94:     model = sm.OLS(y, X).fit(\n95:         cov_type=\"HAC\", cov_kwds={\"maxlags\": max(h, 1)}, use_t=True\n96:     )\n97:     b = float(model.params[1])\n98:     se = float(model.bse[1])\n99:     a = float(model.params[0])\n100:     p_b1 = 2 * (1 - stats.t.cdf(abs((b - 1) / se), df=int(model.df_resid)))\n101:     p_a0 = 2 * (1 - stats.t.cdf(abs(a / float(model.bse[0])), df=int(model.df_resid)))\n102:     return {\n103:         \"mz_slope\": b,\n104:         \"mz_slope_p\": float(p_b1),\n105:         \"mz_intercept\": a,\n106:         \"mz_intercept_p\": float(p_a0),\n107:         \"mz_r2\": float(model.rsquared),\n108:     }\n109: \n110: \n111: def evaluate(forecasts: pd.DataFrame, obs: pd.DataFrame) -> pd.DataFrame:\n112:     fc = attach_realized(forecasts, obs)\n113:     fc = fc.dropna(subset=[\"realized\", \"point\"])\n114:     fc = fc[~((fc[\"target\"] == \"selic\") & (fc[\"horizon\"] == 0))]\n115:     rw = fc[fc[\"model_id\"] == \"random_walk\"]\n116:     focus = fc[fc[\"model_id\"] == \"focus_consensus\"]\n117: \n118:     out = []\n119:     groups = fc.groupby([\"model_id\", \"school\", \"target\", \"horizon\"], dropna=False)\n120:     for (model_id, school, target, horizon), g in groups:\n121:         g = g.sort_values(\"origin_date\")\n122:         err = g[\"error\"].to_numpy()\n123:         y = g[\"realized\"].to_numpy()\n124:         p = g[\"point\"].to_numpy()\n125:         n = len(g)\n126:         rmse = float(np.sqrt(np.mean(err**2)))\n127:         mae = float(np.mean(np.abs(err)))\n128:         bias = float(np.mean(err))\n129:         satellite = bool(\n130:             g[\"notes\"].fillna(\"\").astype(str).str.contains(\"satellite\").any()\n131:         )\n132: \n133:         rwg = rw[(rw[\"target\"] == target) & (rw[\"horizon\"] == horizon)]\n134:         joint = g.merge(\n135:             rwg[[\"origin_date\", \"error\", \"point\", \"realized\"]],\n136:             on=\"origin_date\",\n137:             suffixes=(\"\", \"_rw\"),\n138:             how=\"inner\",\n139:         )\n140:         if len(joint) >= 8:\n141:             theil = float(\n142:                 np.sqrt(np.mean(