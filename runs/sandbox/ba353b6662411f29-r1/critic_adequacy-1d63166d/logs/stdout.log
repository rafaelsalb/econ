{"type":"tool_use","timestamp":1795491199160,"sessionID":"ses_df463e6c2ffeJIQ0xCaosxh4r8","part":{"partID":"prt_20b9d7792001xmyOjJ07fh4n4c","sessionID":"ses_df463e6c2ffeJIQ0xCaosxh4r8","messageID":"msg_20b9cb868001EDgPB8YeogByDx","type":"tool","id":"call_bd329c35a4aa4f8892ddfc13","tool":"read","state":{"status":"completed","input":{"path":"/workspace/in/src/diagnostics.py"},"output":"Read file /workspace/in/src/diagnostics.py, lines 1-140\n1: from __future__ import annotations\n2: \n3: from dataclasses import dataclass, field\n4: from datetime import date\n5: \n6: import numpy as np\n7: import pandas as pd\n8: from statsmodels.stats.diagnostic import acorr_ljungbox\n9: \n10: from .models.new_keynesian import NKFit, estimate\n11: from .vintage import Panel\n12: \n13: \n14: def _lb_p(resid: pd.Series, lags: int = 12) -> float:\n15:     if len(resid.dropna()) < lags + 5:\n16:         return float(\"nan\")\n17:     out = acorr_ljungbox(resid.dropna(), lags=[lags], return_df=True)\n18:     return float(out[\"lb_pvalue\"].iloc[0])\n19: \n20: \n21: def fit_diagnostics(panel: Panel, variant: str = \"R1\") -> dict:\n22:     fit = estimate(panel, variant=variant)\n23:     rows = {\n24:         \"origin\": str(panel.origin),\n25:         \"variant\": variant,\n26:         \"nobs\": fit.nobs,\n27:         \"sample_start\": str(fit.data.index.min()),\n28:         \"sample_end\": str(fit.data.index.max()),\n29:         \"sample_n\": int(len(fit.data)),\n30:         \"rsquared\": {\n31:             \"is\": fit.is_rsquared,\n32:             \"nkpc\": fit.nkpc_rsquared,\n33:             \"taylor\": fit.taylor_rsquared,\n34:         },\n35:         \"condition\": {\n36:             \"is\": fit.condition_is,\n37:             \"nkpc\": fit.condition_nkpc,\n38:             \"taylor\": fit.condition_taylor,\n39:         },\n40:         \"ljung_box_p\": {\n41:             \"is\": _lb_p(fit.is_resid),\n42:             \"nkpc\": _lb_p(fit.nkpc_resid),\n43:             \"taylor\": _lb_p(fit.taylor_resid),\n44:         },\n45:         \"resid_sd\": {\n46:             \"is\": float(fit.is_resid.std()),\n47:             \"nkpc\": float(fit.nkpc_resid.std()),\n48:             \"taylor\": float(fit.taylor_resid.std()),\n49:         },\n50:         \"params\": {\n51:             \"is\": {k: float(v) for k, v in fit.is_params.items()},\n52:             \"nkpc\": {k: float(v) for k, v in fit.nkpc_params.items()},\n53:             \"taylor\": {k: float(v) for k, v in fit.taylor_params.items()},\n54:         },\n55:         \"tstats\": {\n56:             \"is\": {k: float(v) for k, v in fit.is_tstats.items()},\n57:             \"nkpc\": {k: float(v) for k, v in fit.nkpc_tstats.items()},\n58:             \"taylor\": {k: float(v) for k, v in fit.taylor_tstats.items()},\n59:         },\n60:         \"leak_ok\": bool(panel.obs[\"release_date\"].max() <= panel.origin),\n61:         \"max_release\": str(panel.obs[\"release_date\"].max()),\n62:         \"gap\": {\n63:             \"last\": float(fit.gap.iloc[-1]),\n64:             \"mean\": float(fit.gap.mean()),\n65:             \"sd\": float(fit.gap.std()),\n66:         },\n67:     }\n68:     return rows\n69: \n70: \n71: def stability(before: dict, after: dict) -> dict:\n72:     out = {}\n73:     for block in [\"is\", \"nkpc\", \"taylor\"]:\n74:         b = before[\"params\"][block]\n75:         a = after[\"params\"][block]\n76:         keys = sorted(set(b) & set(a))\n77:         out[block] = {\n78:             k: {\n79:                 \"before\": float(b[k]),\n80:                 \"after\": float(a[k]),\n81:                 \"sign_flip\": bool(np.sign(b[k]) != np.sign(a[k])),\n82:                 \"abs_change\": float(abs(a[k] - b[k])),\n83:             }\n84:             for k in keys\n85:         }\n86:         out[block][\"_sign_flips\"] = int(\n87:             sum(1 for k in keys if np.sign(b[k]) != np.sign(a[k]))\n88:         )\n89:     return out\n90: \n91: \n92: def irf_signs(params: dict) -> dict:\n93:     \"\"\"Sign of the implied transmission: policy -> real rate -> gap -> inflation.\"\"\"\n94:     is_p = params[\"is\"]\n95:     nk_p = params[\"nkpc\"]\n96:     tr_p = params[\"taylor\"]\n97:     return {\n98:         \"real_rate_to_gap\": float(np.sign(is_p.get(\"rr\", np.nan))),\n99:         \"gap_to_inflation\": float(np.sign(nk_p.get(\"gap_1\", np.nan))),\n100:         \"fx_to_inflation\": float(np.sign(nk_p.get(\"dfx_1\", np.nan))),\n101:         \"policy_smoothing\": float(np.sign(tr_p.get(\"i_lag\", np.nan))),\n102:         \"inflation_to_policy\": float(np.sign(tr_p.get(\"pi_gap\", np.nan))),\n103:         \"gap_to_policy\": float(np.sign(tr_p.get(\"gap_1\", np.nan))),\n104:     }\n105: \n106: \n107: def forecast_sanity(rows: list) -> dict:\n108:     checks = {}\n109:     for target, lo, hi in [\n110:         (\"ipca_m\", -5.0, 5.0),\n111:         (\"ipca_12m\", -5.0, 40.0),\n112:         (\"gdp_qq\", -15.0, 15.0),\n113:         (\"selic\", 0.0, 40.0),\n114:     ]:\n115:         vals = [r.point for r in rows if r.target == target]\n116:         checks[target] = {\n117:             \"min\": float(min(vals)) if vals else None,\n118:             \"max\": float(max(vals)) if vals else None,\n119:             \"finite\": bool(all(np.isfinite(vals))),\n120:             \"in_range\": bool(vals and min(vals) >= lo and max(vals) <= hi),\n121:         }\n122:     return checks\n123: \n124: \n125: @dataclass\n126: class Defect:\n127:     code: str\n128:     severity: str\n129:     message: str\n130:     evidence: dict = field(default_factory=dict)\n131:     owner: str = \"modeler\"\n132: \n133:     def to_dict(self) -> dict:\n134:         return {\n135:             \"code\": self.code,\n136:             \"severity\": self.severity,\n137:             \"message\": self.message,\n138:             \"evidence\": self.evidence,\n139:             \"owner\": self.owner,\n140:         }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"