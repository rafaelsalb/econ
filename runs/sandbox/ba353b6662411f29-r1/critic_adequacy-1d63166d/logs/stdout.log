r k, v in fit.nkpc_params.items()},\n53:             \"taylor\": {k: float(v) for k, v in fit.taylor_params.items()},\n54:         },\n55:         \"tstats\": {\n56:             \"is\": {k: float(v) for k, v in fit.is_tstats.items()},\n57:             \"nkpc\": {k: float(v) for k, v in fit.nkpc_tstats.items()},\n58:             \"taylor\": {k: float(v) for k, v in fit.taylor_tstats.items()},\n59:         },\n60:         \"leak_ok\": bool(panel.obs[\"release_date\"].max() <= panel.origin),\n61:         \"max_release\": str(panel.obs[\"release_date\"].max()),\n62:         \"gap\": {\n63:             \"last\": float(fit.gap.iloc[-1]),\n64:             \"mean\": float(fit.gap.mean()),\n65:             \"sd\": float(fit.gap.std()),\n66:         },\n67:     }\n68:     return rows\n69: \n70: \n71: def stability(before: dict, after: dict) -> dict:\n72:     out = {}\n73:     for block in [\"is\", \"nkpc\", \"taylor\"]:\n74:         b = before[\"params\"][block]\n75:         a = after[\"params\"][block]\n76:         keys = sorted(set(b) & set(a))\n77:         out[block] = {\n78:             k: {\n79:                 \"before\": float(b[k]),\n80:                 \"after\": float(a[k]),\n81:                 \"sign_flip\": bool(np.sign(b[k]) != np.sign(a[k])),\n82:                 \"abs_change\": float(abs(a[k] - b[k])),\n83:             }\n84:             for k in keys\n85:         }\n86:         out[block][\"_sign_flips\"] = int(\n87:             sum(1 for k in keys if np.sign(b[k]) != np.sign(a[k]))\n88:         )\n89:     return out\n90: \n91: \n92: def irf_signs(params: dict) -> dict:\n93:     \"\"\"Sign of the implied transmission: policy -> real rate -> gap -> inflation.\"\"\"\n94:     is_p = params[\"is\"]\n95:     nk_p = params[\"nkpc\"]\n96:     tr_p = params[\"taylor\"]\n97:     return {\n98:         \"real_rate_to_gap\": float(np.sign(is_p.get(\"rr\", np.nan))),\n99:         \"gap_to_inflation\": float(np.sign(nk_p.get(\"gap_1\", np.nan))),\n100:         \"fx_to_infl