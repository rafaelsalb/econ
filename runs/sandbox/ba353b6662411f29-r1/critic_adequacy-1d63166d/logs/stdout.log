 lo = date.fromisoformat(r[\"config\"][\"start\"])\n55:         hi = date.fromisoformat(r[\"config\"][\"end\"])\n56:         n = len(monthly_origins(lo, hi))\n57:         if best is None or n >= best[0]:\n58:             best = (n, r)\n59:     checks.append(\n60:         {\n61:             \"check\": \"benchmark backtest >=120 origins\",\n62:             \"ok\": best is not None and best[0] >= 120 and not best[1].get(\"failures\"),\n63:             \"detail\": \"no qualifying run\"\n64:             if best is None\n65:             else f\"{best[0]} origins, run={best[1]['run_id']}, failures={len(best[1].get('failures', []))}\",\n66:         }\n67:     )\n68: \n69:     purge_ok = False\n70:     purge_detail = \"no qualifying run\"\n71:     if best is not None:\n72:         run_id = best[1][\"run_id\"]\n73:         part = config.REGISTRY / \"forecasts\" / f\"run_id={run_id}\" / \"part.parquet\"\n74:         run_end = date.fromisoformat(best[1][\"config\"][\"end\"])\n75:         if part.exists():\n76:             run_fc = pd.read_parquet(part)\n77:             max_ref = pd.to_datetime(run_fc[\"ref_date\"]).max().date()\n78:             declared = best[1][\"config\"].get(\"embargo_until\")\n79:             purge_ok = max_ref <= run_end and declared == str(run_end)\n80:             purge_detail = {\n81:                 \"run\": run_id,\n82:                 \"max_ref_date\": str(max_ref),\n83:                 \"validation_end\": str(run_end),\n84:                 \"embargo_until\": declared,\n85:             }\n86:     checks.append(\n87:         {\n88:             \"check\": \"validation targets purged at window end\",\n89:             \"ok\": purge_ok,\n90:             \"detail\": purge_detail,\n91:         }\n92:     )\n93: \n94:     leaks = []\n95:     for origin in [date(2010, 1, 29), date(2015, 6, 30), date(2019, 12, 31), date(2026, 10, 30)]:\n96:         visible = obs[obs[\"release_date\"] <= origin]\n97:         bad = (visible[\"release_date\"] > origin).sum()\n98:         leaks.append({\"origin\": str(origin), \"violations\": int(bad), \"rows\": int(len(visible))})\n99:     checks.append(\n100:         {\n101:             \"check\": \"release-date leak test\",\n102:             \"ok\": all(x[\"violations\"] == 0 for x in leaks),\n103:             \"detail\": leaks,\n104:         }\n105:     )\n106: \n107:     score_path = config.EVAL / \"scoreboard.csv\"\n108:     if score_path.exists():\n109:         score = pd.read_csv(score_path)\n110:         has_focus = {\n111:             t: bool(\n112:                 ((score[\"model_id\"] == \"focus_consensus\") & (score[\"target\"] == t)).any()\n113:             )\n114:             for t in [\"ipca_12m\", \"selic\"]\n115:         }\n116:     else:\n117:         has_focus = {\"ipca_12m\": False, \"selic\": False}\n118:     checks.append(\n119:         {\n120:             \"check\": \"Focus benchmark for IPCA and Selic\",\n121:             \"ok\": all(has_focus.values()),\n122:             \"detail\": has_focus,\n123:         }\n124:     )\n125: \n126:     manifest_path = config.CURATED / \"manifest.json\"\n127:     data_hash = json.loads(manifest_path.read_text())[\"sha256\"] if manifest_path.exists() else \"\"\n128:     checks.append(\n129:         {\n130:             \"check\": \"curated data hash recorded\",\n131:             \"ok\": bool(data_hash),\n132:             \"detail\": data_hash,\n133:         }\n134:     )\n135: \n136:     manifest = config.SPECS / \"new_keynesian.decision.json\"\n137:     checks.append(\n138:         {\n139:             \"check\": \"Phase 1 loop decision recorded\",\n140:             \"ok\": manifest.exists(),\n141:             \"detail\": \"specs/new_keynesian.decision.json\" if manifest.exists() else \"missing\",\n142:         }\n143:     )\n144:     return checks\n145: \n146: \n147: def print_checks() -> bool:\n148:     checks = run_checks()\n149:     ok = all(c[\"ok\"] for c in checks)\n150:     for c in checks:\n151:         print(f\"[{'PASS' if c['ok'] else 'FAIL'}] {c['check']}: {c['detail']}\")\n152:     print(f\"\\n{'ALL CHECKS PASS' if ok else 'CHECKS FAILED'}\")\n153:     return ok","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /workspace/in/src/checks.py, lines 1-153\n1: from __future__ import annotations\n2: \n3: import json\n4: from datetime import date\n5: \n6: import pandas as pd\n7: \n8: from . import config\n9: from .ingest import load_observations\n10: from .utils import monthly_origins\n11: \n12: \n13: def _runs() -> list[dict]:\n14:     path = config.REGISTRY / \"runs.jsonl\"\n15:     if not path.exists():\n16:         return []\n17:     return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]\n18: \n19: \n20: def run_checks() -> list[dict]:\n21:     checks = []\n22:     obs = load_observations()\n23: \n24:     expected = {\n25:         \"ipca_m\",\n26:         \"ibc_br\",\n27:         \"selic_target\",\n28:         \"fx_usdbrl\",\n29:         \"gdp_qq\",\n30:         \"focus_ipca_12m\",\n31:         \"focus_ipca_annual\",\n32:     }\n33:     present = set(obs[\"series_id\"].unique())\n34:     checks.append(\n35:         {\n36:             \"check\": \"catalog coverage\",\n37:             \"ok\": expected <= present,\n38:             \"detail\": f\"missing={sorted(expected - present)}\",\n39:         }\n40:     )\n41: \n42:     runs = _runs()\n43:     benchmark_runs = [\n44:         r\n45:         for r in runs\n46:         if set([\"random_walk\", \"seasonal_naive\", \"ar\", \"bvar\", \"focus_consensus\"]).issubset(\n47:             set(r.get(\"models\", []))\n48:         )\n49:         and r.get(\"config\", {}).get(\"start\")\n50:         and not r.get(\"config\", {}).get(\"model_kwargs\")\n51:     ]\n52:     best = None\n53:     for r in benchmark_runs:\n54:         lo = date.fromisoformat(r[\"config\"][\"start\"])\n55:         hi = date.fromisoformat(r[\"config\"][\"end\"])\n56:         n = len(monthly_origins(lo, hi))\n57:         if best is None or n >= best[0]:\n58:             best = (n, r)\n59:     checks.append(\n60:         {\n61:             \"check\": \"benchmark backtest >=120 origins\",\n62:             \"ok\": best is not None and best[0] >= 120 and not best[1].get(\"failures\"),\n63:             \"detail\": \"no qualifying run\"\n64:             if best is None\n65:             else f\"{best[0]} origins, run={best[1]['run_id']}, failures={len(best[1].get('failures', []))}\",\n66:         }\n67:     )\n68: \n69:     purge_ok = False\n70:     purge_detail = \"no qualifying run\"\n71:     if best is not None:\n72:         run_id = best[1][\"run_id\"]\n73:         part = config.REGISTRY / \"forecasts\" / f\"run_id={run_id}\" / \"part.parquet\"\n74:         run_end = date.fromisoformat(best[1][\"config\"][\"end\"])\n75:         if part.exists():\n76:             run_fc = pd.read_parquet(part)\n77:             max_ref = pd.to_datetime(run_fc[\"ref_date\"]).max().date()\n78:             declared = best[1][\"config\"].get(\"embargo_until\")\n79:             purge_ok = max_ref <= run_end and declared == str(run_end)\n80:             purge_detail = {\n81:                 \"run\": run_id,\n82:                 \"max_ref_date\": str(max_ref),\n83:                 \"validation_end\": str(run_end),\n84:                 \"embargo_until\": declared,\n85:             }\n86:     checks.append(\n87:         {\n88:             \"check\": \"validation targets purged at window end\",\n89:             \"ok\": purge_ok,\n90:             \"detail\": purge_detail,\n91:         }\n92:     )\n93: \n94:     leaks = []\n95:     for origin in [date(2010, 1, 29), date(2015, 6, 30), date(2019, 12, 31), date(2026, 10, 30)]:\n96:         visible = obs[obs[\"release_date\"] <= origin]\n97:         bad = (visible[\"release_date\"] > origin).sum()\n98:         leaks.append({\"origin\": str(origin), \"violations\": int(bad), \"rows\": int(len(visible))})\n99:     checks.append(\n100:         {\n101:             \"check\": \"release-date leak test\",\n102:             \"ok\": all(x[\"violations\"] == 0 for x in leaks),\n103:             \"detail\": leaks,\n104:         }\n105:     )\n106: \n107:     score_path = config.EVAL / \"scoreboard.csv\"\n108:     if score_path.exists():\n109:         score = pd.read_csv(score_path)\n110:         has_focus = {\n111:             t: bool(\n112:                 ((score[\"model_id\"] == \"focus_consensus\") & (score[\"target\"] == t)).any()\n113:             )\n114:             for t in [\"ipca_12m\", \"selic\"]\n115:         }\n116:     else:\n117:         has_focus = {\"ipca_12m\": False, \"selic\": False}\n118:     checks.append(\n119:         {\n120:             \"check\": \"Focus benchmark for IPCA and Selic\",\n121:             \"ok\": all(has_focus.values()),\n122:             \"detail\": has_focus,\n123:         }\n124:     )\n125: \n126:     manifest_path = config.CURATED / \"manifest.json\"\n127:     data_hash = json.loads(manifest_path.read_text())[\"sha256\"] if manifest_path.exists() else \"\"\n128:     checks.append(\n129:         {\n130:             \"check\": \"curated data hash recorded\",\n131:             \"ok\": bool(data_hash),\n132:             \"detail\": data_hash,\n133:         }\n134:     )\n135: \n136:     manifest = config.SPECS / \"new_keynesian.decision.json\"\n137:     checks.append(\n138:         {\n139:             \"check\": \"Phase 1 loop decision recorded\",\n140:             \"ok\": manifest.exists(),\n141:             \"detail\": \"specs/new_keynesian.decision.json\" if manifest.exists() else \"missing\",\n142:         }\n143:     )\n144:     return checks\n145: \n146: \n147: def print_checks() -> bool:\n148:     checks = run_checks()\n149:     ok = all(c[\"ok\"] for c in checks)\n150:     for c in checks:\n151:         print(f\"[{'PASS' if c['ok'] else 'FAIL'}] {c['check']}: {c['detail']}\")\n152:     print(f\"\\n{'ALL CHECKS PASS' if ok else 'CHECKS FAILED'}\")\n153:     return 