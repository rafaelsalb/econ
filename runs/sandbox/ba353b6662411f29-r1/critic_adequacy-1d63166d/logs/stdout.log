       \"embargo_until\": str(embargo_until),\n51:         \"models\": model_ids,\n52:         \"model_kwargs\": model_kwargs,\n53:         \"estimation_start\": config.ESTIMATION_START,\n54:     }\n55:     ctx = RunContext.create(model_ids, config_dict, seed=seed)\n56:     if save and ctx.exists() and not force:\n57:         df = pd.read_parquet(ctx.directory / \"part.parquet\")\n58:         return ctx, df\n59: \n60:     obs = load_observations()\n61:     origins = monthly_origins(start, end)\n62:     if len(origins) < 12:\n63:         raise ValueError(\"backtest needs at least 12 origins\")\n64: \n65:     instances = {m: reg[m](**model_kwargs.get(m, {})) for m in model_ids}\n66:     rows: list[dict] = []\n67:     failures: list[dict] = []\n68:     np.random.seed(seed)\n69:     produced_at = datetime.now().isoformat(timespec=\"seconds\")\n70: \n71:     for i, origin in enumerate(origins):\n72:         panel = Panel.build(origin, obs)\n73:         vintage = max(panel.obs[\"vintage_date\"]) if not panel.obs.empty else None\n74:         for model_id, model in instances.items():\n75:             try:\n76:                 fcs = model.forecast(panel)\n77:             except Exception as exc:  # noqa: BLE001\n78:                 failures.append(\n79:                     {\"model\": model_id, \"origin\": str(origin), \"error\": f\"{type(exc).__name__}: {exc}\"}\n80:                 )\n81:                 continue\n82:             for f in fcs:\n83:                 if f.ref_date > embargo_until:\n84:                     continue\n85:                 row = {\n86:                     \"model_id\": model_id,\n87:                     \"school\": getattr(model, \"school\", \"unknown\"),\n88:                     \"target\": f.target,\n89:                     \"horizon\": int(f.horizon),\n90:                     \"origin_date\": origin,\n91:                     \"ref_date\": f.ref_date,\n92:                     \"vintage_date\": vintage,\n93:                     \"point\": float(f