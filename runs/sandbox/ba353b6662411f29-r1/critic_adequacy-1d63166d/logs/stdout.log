             \"rmse\": rmse,\n188:                 \"mae\": mae,\n189:                 \"bias\": bias,\n190:                 \"theil_u\": theil,\n191:                 \"dm_stat\": dm_stat,\n192:                 \"dm_p\": dm_p,\n193:                 \"focus_ratio\": focus_ratio,\n194:                 \"dm_focus_stat\": dm_focus_stat,\n195:                 \"dm_focus_p\": dm_focus_p,\n196:                 **mz,\n197:                 \"direction\": da,\n198:                 \"satellite\": satellite,\n199:                 \"max_ref_date\": g[\"ref_date\"].max(),\n200:                 \"primary\": int(horizon) in PRIMARY_HORIZONS.get(target, []),\n201:                 \"first_origin\": g[\"origin_date\"].min(),\n202:                 \"last_origin\": g[\"origin_date\"].max(),\n203:             }\n204:         )\n205:     metrics = pd.DataFrame(out)\n206:     metrics[\"rank\"] = (\n207:         metrics.groupby([\"target\", \"horizon\"])[\"rmse\"].rank(method=\"min\").astype(\"Int64\")\n208:     )\n209:     return metrics.sort_values([\"target\", \"horizon\", \"rmse\"]).reset_index(drop=True)\n210: \n211: \n212: def episode_metrics(forecasts: pd.DataFrame, obs: pd.DataFrame) -> pd.DataFrame:\n213:     fc = attach_realized(forecasts, obs).dropna(subset=[\"realized\", \"point\"])\n214:     fc = fc[~((fc[\"target\"] == \"selic\") & (fc[\"horizon\"] == 0))]\n215:     rows = []\n216:     for name, (lo, hi) in EPISODES.items():\n217:         lo_d, hi_d = date.fromisoformat(lo), date.fromisoformat(hi)\n218:         sub = fc[(fc[\"origin_date\"] >= lo_d) & (fc[\"origin_date\"] <= hi_d)]\n219:         if sub.empty:\n220:             continue\n221:         rw = sub[sub[\"model_id\"] == \"random_walk\"]\n222:         for (model_id, target, horizon), g in sub.groupby(\n223:             [\"model_id\", \"target\", \"horizon\"]\n224:         ):\n225:             rmse = float(np.sqrt(np.mean(g[\"error\"] ** 2)))\n226:             rwg = rw[(rw[\"target\"] == target) & (rw[\"horizon\"] == horizon)]\n227:             joint = g.merge(rwg[[\"origin_date\", \"error\"]], on=\"origin_date\", suffixes=(\"\", \"_rw\"))\n228:             theil = (\n229:                 float(\n230:                     np.sqrt(np.mean(joint[\"error\"] ** 2))\n231:                     / np.sqrt(np.mean(joint[\"error_rw\"] ** 2))\n232:                 )\n233:                 if len(joint) >= 5\n234:                 else np.nan\n235:             )\n236:             rows.append(\n237:                 {\n238:                     \"episode\": name,\n239:                     \"model_id\": model_id,\n240:                     \"target\": target,\n241:                     \"horizon\": int(horizon),\n242:                     \"n\": len(g),\n243:                     \"rmse\": rmse,\n244:                     \"theil_u\": theil,\n245:                 }\n246:             )\n247:     return pd.DataFrame(rows)\n248: \n249: \n250: def write_outputs(metrics: pd.DataFrame, episodes: pd.DataFrame) -> None:\n251:     config.EVAL.mkdir(parents=True, exist_ok=True)\n252:     metrics.to_csv(config.EVAL / \"scoreboard.csv\", index=False)\n253:     episodes.to_csv(config.EVAL / \"episodes.csv\", index=False)\n254: \n255:     lines = [\"# Brazil macro model hub — scoreboard\", \"\"]\n256:     lines.append(f\"Generated from registry run(s). {len(metrics)} model-target-horizon rows.\")\n257:     lines.append(\"\")\n258:     for target in [\"ipca_m\", \"ipca_12m\", \"gdp_qq\", \"selic\"]:\n259:         sub = metrics[metrics[\"target\"] == target]\n260:         if sub.empty:\n261:             continue\n262:         lines.append(f\"## {target}\")\n263:         lines.append(\"\")\n264:         lines.append(\n265:             \"| model | h | n | RMSE | Theil U | DM p | MZ slope | MZ p(b=1) | Dir. |\"\n266:         )\n267:         lines.append(\"|---|---:|---:|---:|---:|---:|---:|---:|---:|\")\n268:         for _, r in sub.iterrows():\n269:             def fmt(v, d=3):\n270:                 return \"—\" if pd.isna