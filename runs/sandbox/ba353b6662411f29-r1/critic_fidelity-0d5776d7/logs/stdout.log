\"\"\"Sign of the implied transmission: policy -> real rate -> gap -> inflation.\"\"\"\n94:     is_p = params[\"is\"]\n95:     nk_p = params[\"nkpc\"]\n96:     tr_p = params[\"taylor\"]\n97:     return {\n98:         \"real_rate_to_gap\": float(np.sign(is_p.get(\"rr\", np.nan))),\n99:         \"gap_to_inflation\": float(np.sign(nk_p.get(\"gap_1\", np.nan))),\n100:         \"fx_to_inflation\": float(np.sign(nk_p.get(\"dfx_1\", np.nan))),\n101:         \"policy_smoothing\": float(np.sign(tr_p.get(\"i_lag\", np.nan))),\n102:         \"inflation_to_policy\": float(np.sign(tr_p.get(\"pi_gap\", np.nan))),\n103:         \"gap_to_policy\": float(np.sign(tr_p.get(\"gap_1\", np.nan))),\n104:     }\n105: \n106: \n107: def forecast_sanity(rows: list) -> dict:\n108:     checks = {}\n109:     for target, lo, hi in [\n110:         (\"ipca_m\", -5.0, 5.0),\n111:         (\"ipca_12m\", -5.0, 40.0),\n112:         (\"gdp_qq\", -15.0, 15.0),\n113:         (\"selic\", 0.0, 40.0),\n114:     ]:\n115:         vals = [r.point for r in rows if r.target == target]\n116:         checks[target] = {\n117:             \"min\": float(min(vals)) if vals else None,\n118:             \"max\": float(max(vals)) if vals else None,\n119:             \"finite\": bool(all(np.isfinite(vals))),\n120:             \"in_range\": bool(vals and min(vals) >= lo and max(vals) <= hi),\n121:         }\n122:     return checks\n123: \n124: \n125: @dataclass\n126: class Defect:\n127:     code: str\n128:     severity: str\n129:     message: str\n130:     evidence: dict = field(default_factory=dict)\n131:     owner: str = \"modeler\"\n132: \n133:     def to_dict(self) -> dict:\n134:         return {\n135:             \"code\": self.code,\n136:             \"severity\": self.severity,\n137:             \"message\": self.message,\n138:             \"evidence\": self.evidence,\n139:             \"owner\": self.owner,\n140:         }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"