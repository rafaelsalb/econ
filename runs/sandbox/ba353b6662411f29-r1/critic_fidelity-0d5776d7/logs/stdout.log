nt: bool = True):\n51:     design = sm.add_constant(X) if constant else X\n52:     return sm.OLS(y, design).fit(\n53:         cov_type=\"HAC\", cov_kwds={\"maxlags\": 12}, use_t=True\n54:     )\n55: \n56: \n57: def _covid_terms(df: pd.DataFrame) -> list[str]:\n58:     return [\"covid\"] if df[\"covid\"].nunique(dropna=True) > 1 else []\n59: \n60: \n61: def build_dataset(panel: Panel, est_start: str = NK_ESTIMATION_START) -> pd.DataFrame:\n62:     pi = panel.monthly(\"ipca_m\")\n63:     ibc = panel.monthly(\"ibc_br\")\n64:     selic = panel.monthly(\"selic_target\")\n65:     fx = panel.monthly(\"fx_usdbrl\")\n66:     focus = panel.monthly(\"focus_ipca_12m\")\n67: \n68:     df = pd.concat(\n69:         [\n70:             pi.rename(\"pi\"),\n71:             ibc.rename(\"ibc\"),\n72:             selic.rename(\"selic\"),\n73:             fx.rename(\"fx\"),\n74:             focus.rename(\"focus\"),\n75:         ],\n76:         axis=1,\n77:         join=\"inner\",\n78:     ).dropna()\n79:     start = pd.Period(est_start, \"M\")\n80:     df = df[df.index >= start]\n81:     if len(df) < 60:\n82:         raise ValueError(f\"NK: insufficient history ({len(df)} months)\")\n83: \n84:     cycle, trend = hpfilter(np.log(df[\"ibc\"]), lamb=HP_LAMBDA)\n85:     df[\"gap\"] = 100.0 * cycle\n86:     df[\"trend_log\"] = trend\n87:     df[\"dfx\"] = 100.0 * np.log(df[\"fx\"]).diff()\n88:     df[\"pi12\"] = ((1 + df[\"pi\"] / 100).rolling(12).apply(np.prod, raw=True) - 1) * 100\n89:     df[\"pi_e\"] = ((1 + df[\"focus\"] / 100) ** (1 / 12) - 1) * 100\n90:     df[\"r\"] = df[\"selic\"] - df[\"focus\"]\n91:     df[\"target\"] = [target_for(p.start_time.date()) for p in df.index]\n92:     df[\"covid\"] = [covid_flag(p) for p in df.index]\n93:     return df\n94: \n95: \n96: def estimate(panel: Panel, est_start: str = NK_ESTIMATION_START, variant: str = \"R1\") -> NKFit:\n97:     df = build_dataset(panel, est_start)\n98:     d = df.copy()\n99:     for col in [\"gap\", \"pi\", \"r\", \"dfx\", \"pi12\", \"selic\"]:\n100:         d[f\"{col}_1\"] = d[col].shift(1)\n101:         d[f\"{col}_2\"] = d[col].shift(2)\n102: \n103:     # --- IS curve -----------------------------------------------------------\n104:     is_df = d.dropna(subset=[\"gap\", \"gap_1\", \"gap_2\", \"r_1\"]).copy()\n105:     is_df[\"rr\"] = is_df[\"r_1\"] - RSTAR\n106:     cols_is = [\"gap_1\", \"gap_2\", \"rr\"] + _covid_terms(is_df)\n107:     X_is = is_df[cols_is]\n108:     is_res = _ols(is_df[\"gap\"], X_is)\n109:     is_resid = pd.Series(is_res.resid.to_numpy(), index=is_df.index)\n110: \n111:     # --- Hybrid NKPC with long-run neutrality imposed -----------------------\n112:     # pi_t - pi_e_t = c + b1 (pi_{t-1} - pi_e_t) + b2 (pi_{t-2} - pi_e_t)\n113:     #                 + b4 gap_{t-1} + b5 dfx_{t-1} + e\n114:     nk_df = d.dropna(subset=[\"pi\", \"pi_1\", \"pi_2\", \"pi_e\", \"gap_1\", \"dfx_1\"]).copy()\n115:     nk_df[\"pi_rel\"] = nk_df[\"pi\"] - nk_df[\"pi_e\"]\n116:     nk_df[\"pi1_rel\"] = nk_df[\"pi_1\"] - nk_df[\"pi_e\"]\n117:     nk_df[\"pi2_rel\"] = nk_df[\"pi_2\"] - nk_df[\"pi_e\"]\n118:     cols_nk = [\"pi1_rel\", \"pi2_rel\", \"gap_1\", \"dfx_1\"] + _covid_terms(nk_df)\n119:     X_nk = nk_df[cols_nk]\n120:     nk_res = _ols(nk_df[\"pi_rel\"], X_nk)\n121:     nk_resid = pd.Series(nk_res.resid.to_numpy(), index=nk_df.index)\n122:     nk_params = nk_res.params.copy()\n123:     nk_params[\"pi_e\"] = 1.0 - nk_params[\"pi1_rel\"] - nk_params[\"pi2_rel\"]\n124: \n125:     # --- Taylor rule with neutral real rate imposed -------------------------\n126:     # i_t - target_t - rstar = rho (i_{t-1} - target_t - rstar)\n127:     #                          + g1 (pi12_{t-1} - target_t) + g2 gap_{t-1} + e\n128:     # R3 replaces lagged inflation with the survey 12m expectation.\n129:     tr_df = d.dropna(subset=[\"selic\", \"selic_1\", \"gap_1\"]).copy()\n130:     if variant == \"R3\":\n131:         tr_df = tr_df.dropna(subset=[\"focus\"])\n132:         tr_df[\"anchor_gap\"] = tr_df[\"focus\"] - tr_df[\"target\"]\n133:         anchor_col = \"anchor_gap\"\n134:     else:\n135:         tr_df = tr_df.dropna(subset=[\"pi12_1\"])\n136:         tr_df[\"anchor_gap\"] = tr_df[\"pi12_1\"] - tr_df[\"target\"]\n137:         anchor_col = \"anchor_gap\"\n138:     tr_df[\"lhs\"] = tr_df[\"selic\"] - tr_df[\"target\"] - RSTAR\n139:     tr_df[\"i_lag\"] = tr_df[\"selic_1\"] - tr_df[\"target\"] - RSTAR\n140:     cols_tr = [\"i_lag\", anchor_col, \"gap_1\"]\n141:     tr_res = _ols(tr_df[\"lhs\"], tr_df[cols_tr], constant=False)\n142:     tr_resid = pd.Series(tr_res.resid.to_numpy(), index=tr_df.index)\n143:     tr_params = tr_res.params.copy()\n144:     tr_params[\"const\"] = 0.0\n145:     tr_params = tr_params.rename({anchor_col: \"pi_gap\"})\n146:     tr_tstats = tr_res.tvalues.rename({anchor_col: \"pi_gap\"})\n147: \n148:     def cond(X: pd.DataFrame, constant: bool = True) -> float:\n149:         x = (sm.add_constant(X) if constant else X).to_numpy()\n150:         return float(np.linalg.cond(x))\n151: \n152:     return NKFit(\n153:         is_params=is_res.params,\n154:         nkpc_params=nk_params,\n155:         taylor_params=tr_params,\n156:         is_tstats=is_res.tvalues,\n157:         nkpc_tstats=nk_res.tvalues,\n158:         taylor_tstats=tr_tstats,\n159:         is_resid=is_resid,\n160:         nkpc_resid=nk_resid,\n161:         taylor_resid=tr_resid,\n162:         is_rsquared=float(is_res.rsquared),\n163:         nkpc_rsquared=float(nk_res.rsquared),\n164:         taylor_rsquared=float(tr_res.rsquared),\n165:         data=df,\n166:         gap=df[\"gap\"],\n167:         trend=df[\"trend_log\"],\n168:         condition_is=cond(X_is),\n169:         condition_nkpc=cond(X_nk),\n170:         condition_taylor=cond(tr_df[cols_tr], constant=False),\n171:         nobs={\n172:             \"is\": int(is_res.nobs),\n173:             \"nkpc\": int(nk_res.nobs),\n174:             \"taylor\": int(tr_res.nobs),\n175:         },\n176:     )\n177: \n178: \n179: def _coef(params: pd.Series, name: str) -> float:\n180:     return float(params[name]) if name in params.index else 0.0\n181: \n182: \n183: def _forecast_paths(panel: Panel, fit: NKFit, variant: str = \"R1\", steps: int = 14):\n184:     m0 = month_of(panel.origin)\n185:     pi_hist = panel.monthly(\"ipca_m\")\n186:     selic_hist = panel.monthly(\"selic_target\")\n187:     focus_hist = panel.monthly(\"focus_ipca_12m\")\n188:     ibc_hist = panel.monthly(\"ibc_br\")\n189:     fx_hist = panel.monthly(\"fx_usdbrl\")\n190: \n191:     gap = fit.gap\n192:     if gap.index[-1] != m0 - 1:\n193:         raise ValueError(f\"NK gap ends {gap.index[-1]}, expected {m0 - 1}\")\n194: \n195:     i_M = float(selic_hist.loc[m0])\n196:     focus_M = float(focus_hist.loc[m0])\n197:     pi_e_m = ((1 + focus_M / 100) ** (1 / 12) - 1) * 100\n198: \n199:     b_is = fit.is_params\n200:     b_nk = fit.nkpc_params\n201:     b_tr = fit.taylor_params\n202: \n203:     path_pi: dict[pd.Period, float] = {\n204:         m0 - 1: float(pi_hist.loc[m0 - 1]),\n205:         m0 - 2: float(pi_hist.loc[m0 - 2]),\n206:     }\n207:     path_gap: dict[pd.Period, float] = {\n208:         m0 - 1: float(gap.loc[m0 - 1]),\n209:         m0 - 2: float(gap.loc[m0 - 2]),\n210:     }\n211:     path_i: dict[pd.Period, float] = {m0: i_M}\n212: \n213:     dfx_minus1 = float(100 * np.log(fx_hist.loc[m0 - 1] / fx_hist.loc[m0 - 2]))\n214:     # A pre-COVID origin cannot know the pandemic regime. The dummy is only used\n215:     # for forecast months when the origin is already inside the COVID window.\n216:     origin_has_covid = panel.origin >= COVID_START.start_time.date()\n217: \n218:     for j in range(0, steps + 1):\n219:         t = m0 + j\n220:         covid_term = covid_flag(t) if origin_has_covid else 0.0\n221:         gap_1, gap_2 = path_gap[t - 1], path_gap[t - 2]\n222:         r_1 = (\n223:             float(selic_hist.loc[m0 - 1] - focus_hist.loc[m0 - 1])\n224:             if j == 0\n225:             else path_i[t - 1] - focus_M\n226:         )\n227:         path_gap[t] = float(\n228:             _coef(b_is, \"const\")\n229:             + _coef(b_is, \"gap_1\") * gap_1\n230:             + _coef(b_is, \"gap_2\") * gap_2\n231:             + _coef(b_is, \"rr\") * (r_1 - RSTAR)\n232:             + _coef(b_is, \"covid\") * covid_term\n233:         )\n234: \n235:         pi_1, pi_2 = path_pi[t - 1], path_pi[t - 2]\n236:         dfx_1 = dfx_minus1 if j == 0 else 0.0\n237:         path_pi[t] = float(\n238:             _coef(b_nk, \"const\")\n239:             + _coef(b_nk, \"pi1_rel\") * pi_1\n240:             + _coef(b_nk, \"pi2_rel\") * pi_2\n241:             + _coef(b_nk, \"pi_e\") * pi_e_m\n242:             + _coef(b_nk, \"gap_1\") * gap_1\n243:             + _coef(b_nk, \"dfx_1\") * dfx_1\n244:             + _coef(b_nk, \"covid\") * covid_term\n245:         )\n246: \n247:         if j > 0:\n248:             full_pi = pd.concat([pi_hist, pd.Series(path_pi).sort_index()])\n249:             full_pi = full_pi[~full_pi.index.duplicated(keep=\"last\")].sort_index()\n250:             window = pd.period_range(t - 12, t - 1, freq=\"M\")\n251:             pi12_prev = compound(full_pi.loc[window])\n252:             target_t = target_for(t.start_time.date())\n253:             anchor = focus_M if variant == \"R3\" else pi12_prev\n254:             path_i[t] = float(\n255:                 target_t\n256:                 + RSTAR\n257:                 + _coef(b_tr, \"i_lag\") * (path_i[t - 1] - target_t - RSTAR)\n258:                 + _coef(b_tr, \"pi_gap\") * (anchor - target_t)\n259:                 + _coef(b_tr, \"gap_1\") * path_gap[t - 1]\n260:             )\n261: \n262:     pi_path = pd.Series(path_pi).sort_index()\n263:     gap_path = pd.Series(path_gap).sort_index()\n264:     i_path = pd.Series(path_i).sort_index()\n265: \n266:     # --- GDP bridge ---------------------------------------------------------\n267:     if variant in {\"R2\", \"R3\"}:\n268:         growth = (100 * np.log(ibc_hist).diff()).dropna()\n269:         p_g, beta_g = fit_ar(growth.to_numpy(), 3)\n270:         gfc = forecast_ar(growth.to_numpy(), p_g, beta_g, steps + 1)\n271:         levels: dict[pd.Period, float] = {m0 - 1: float(ibc_hist.loc[m0 - 1])}\n272:         for j, g in enumerate(gfc):\n273:             t = m0 + j\n274:             levels[t] = levels[t - 1] * np.exp(g / 100.0)\n275:     else:\n276:         trend = fit.trend\n277:         g_trend = float(np.mean(np.diff(trend.to_numpy())[-12:]))\n278:         levels = {m0 - 1: float(ibc_hist.loc[m0 - 1])}\n279:         for j in range(0, steps + 1):\n280:             t = m0 + j\n281:             levels[t] = levels[t - 1] * np.exp(\n282:                 g_trend + (gap_path[t] - gap_path[t - 1]) / 100.0\n283:             )\n284: \n285:     q0 = quarter_of(panel.origin)\n286: \n287:     def quarter_ibc(q: pd.Period) -> float:\n288:         months = pd.period_range(q.start_time, q.end_time, freq=\"M\")\n289:         vals = []\n290:         for m in months:\n291:             vals.append(\n292:                 float(ibc_hist.loc[m]) if m <= m0 - 1 else float(levels[m])\n293:             )\n294:         return float(np.mean(vals))\n295: \n296:     qlevels = {q: quarter_ibc(q) for q in pd.period_range(q0 - 3, q0 + 4, freq=\"Q\")}\n297:     ibc_qq = {\n298:         q: 100 * np.log(qlevels[q] / qlevels[q - 1])\n299:         for q in pd.period_range(q0 - 2, q0 + 4, freq=\"Q\")\n300:     }\n301: \n302:     ibc_q = ibc_hist.groupby(ibc_hist.index.asfreq(\"Q\")).mean()\n303:     counts = ibc_hist.groupby(ibc_hist.index.asfreq(\"Q\")).count()\n304:     ibc_q = ibc_q[counts == 3]\n305:     ibc_q_qq = 100 * np.log(ibc_q).diff()\n306:     gdp = panel.quarterly(\"gdp_qq\")\n307:     bridge = pd.concat([gdp.rename(\"gdp\"), ibc_q_qq.rename(\"ibc\")], axis=1, join=\"inner\")\n308:     bridge[\"ibc_lag\"] = bridge[\"ibc\"].shift(1)\n309:     bridge = bridge.dropna()\n310:     bridge = bridge[bridge.index >= pd.Period(ESTIMATION_START, \"Q\")]\n311:     if len(bridge) < 20:\n312:         raise ValueError(\"NK bridge: insufficient history\")\n313:     Xb = np.column_stack(\n314:         [np.ones(len(bridge)), bridge[\"ibc\"].to_numpy(), bridge[\"ibc_lag\"].to_numpy()]\n315:     )\n316:     beta, *_ = np.linalg.lstsq(Xb, bridge[\"gdp\"].to_numpy(), rcond=None)\n317: \n318:     gdp_fc = {\n319:         h: float(\n320:             beta[0] + beta[1] * ibc_qq[q0 + h] + beta[2] * ibc_qq[q0 + h - 1]\n321:         )\n322:         for h in range(5)\n323:     }\n324: \n325:     return pi_path, i_path, gap_path, pd.Series(gdp_fc), focus_M\n326: \n327: \n328: class NewKeynesian:\n329:     model_id = \"new_keynesian\"\n330:     school = \"new_keynesian\"\n331: \n332:     def __init__(self, est_start: str = NK_ESTIMATION_START, variant: str = \"R1\"):\n333:         if variant not in {\"R1\", \"R2\", \"R3\"}:\n334:             raise ValueError(f\"unknown NK variant {variant}\")\n335:         self.est_start = est_start\n336:         self.variant = variant\n337:         self.fit: NKFit | None = None\n338: \n339:     def forecast(self, panel: Panel) -> list[Forecast]:\n340:         self.fit = estimate(panel, self.est_start, self.variant)\n341:         pi_path, i_path, gap_path, gdp_fc, _ = _forecast_paths(\n342:             panel, self.fit, self.variant\n343:         )\n344: \n345:         pi_hist = panel.monthly(\"ipca_m\")\n346:         gdp = panel.quarterly(\"gdp_qq\")\n347:         selic = panel.monthly(\"selic_target\")\n348: \n349:         rows = ipca_rows(pi_path, pi_hist, panel.origin)\n350:         gdp_forecasts = gdp_rows(gdp_fc.to_dict(), panel.origin, float(gdp.iloc[-1]))\n351:         for row in gdp_forecasts:\n352:             row.notes = \"satellite_bridge; shared with ibc_bridge\"\n353:         rows += gdp_forecasts\n354:         rows += selic_rows(i_path, panel.origin, float(selic.iloc[-1]))\n355:         return validate_rows(rows, self.model_id)","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /workspace/in/src/models/new_keynesian.py, lines 1-355\n1: from __future__ import annotations\n2: \n3: from dataclasses import dataclass, field\n4: from datetime import date\n5: \n6: import numpy as np\n7: import pandas as pd\n8: import statsmodels.api as sm\n9: from statsmodels.tsa.filters.hp_filter import hpfilter\n10: \n11: from ..config import ESTIMATION_START, NK_ESTIMATION_START\n12: from ..targets import compound, month_of, quarter_of, target_for\n13: from ..vintage import Panel\n14: from .base import Forecast, validate_rows\n15: from .common import fit_ar, forecast_ar, gdp_rows, ipca_rows, selic_rows\n16: \n17: RSTAR = 4.0\n18: HP_LAMBDA = 129600.0\n19: COVID_START = pd.Period(\"2020-03\", \"M\")\n20: COVID_END = pd.Period(\"2020-12\", \"M\")\n21: \n22: \n23: def covid_flag(p: pd.Period) -> float:\n24:     return 1.0 if COVID_START <= p <= COVID_END else 0.0\n25: \n26: \n27: @dataclass\n28: class NKFit:\n29:     is_params: pd.Series\n30:     nkpc_params: pd.Series\n31:     taylor_params: pd.Series\n32:     is_tstats: pd.Series\n33:     nkpc_tstats: pd.Series\n34:     taylor_tstats: pd.Series\n35:     is_resid: pd.Series\n36:     nkpc_resid: pd.Series\n37:     taylor_resid: pd.Series\n38:     is_rsquared: float\n39:     nkpc_rsquared: float\n40:     taylor_rsquared: float\n41:     data: pd.DataFrame\n42:     gap: pd.Series\n43:     trend: pd.Series\n44:     condition_is: float\n45:     condition_nkpc: float\n46:     condition_taylor: float\n47:     nobs: dict[str, int] = field(default_factory=dict)\n48: \n49: \n50: def _ols(y: pd.Series, X: pd.DataFrame, constant: bool = True):\n51:     design = sm.add_constant(X) if constant else X\n52:     return sm.OLS(y, design).fit(\n53:         cov_type=\"HAC\", cov_kwds={\"maxlags\": 12}, use_t=True\n54:     )\n55: \n56: \n57: def _covid_terms(df: pd.DataFrame) -> list[str]:\n58:     return [\"covid\"] if df[\"covid\"].nunique(dropna=True) > 1 else []\n59: \n60: \n61: def build_dataset(panel: Panel, est_start: str = NK_ESTIMATION_START) -> pd.DataFrame:\n62:     pi = panel.monthly(\"ipca_m\")\n63:     ibc = panel.monthly(\"ibc_br\")\n64:     selic = panel.monthly(\"selic_target\")\n65:     fx = panel.monthly(\"fx_usdbrl\")\n66:     focus = panel.monthly(\"focus_ipca_12m\")\n67: \n68:     df = pd.concat(\n69:         [\n70:             pi.rename(\"pi\"),\n71:             ibc.rename(\"ibc\"),\n72:             selic.rename(\"selic\"),\n73:             fx.rename(\"fx\"),\n74:             focus.rename(\"focus\"),\n75:         ],\n76:         axis=1,\n77:         join=\"inner\",\n78:     ).dropna()\n79:     start = pd.Period(est_start, \"M\")\n80:     df = df[df.index >= start]\n81:     if len(df) < 60:\n82:         raise ValueError(f\"NK: insufficient history ({len(df)} months)\")\n83: \n84:     cycle, trend = hpfilter(np.log(df[\"ibc\"]), lamb=HP_LAMBDA)\n85:     df[\"gap\"] = 100.0 * cycle\n86:     df[\"trend_log\"] = trend\n87:     df[\"dfx\"] = 100.0 * np.log(df[\"fx\"]).diff()\n88:     df[\"pi12\"] = ((1 + df[\"pi\"] / 100).rolling(12).apply(np.prod, raw=True) - 1) * 100\n89:     df[\"pi_e\"] = ((1 + df[\"focus\"] / 100) ** (1 / 12) - 1) * 100\n90:     df[\"r\"] = df[\"selic\"] - df[\"focus\"]\n91:     df[\"target\"] = [target_for(p.start_time.date()) for p in df.index]\n92:     df[\"covid\"] = [covid_flag(p) for p in df.index]\n93:     return df\n94: \n95: \n96: def estimate(panel: Panel, est_start: str = NK_ESTIMATION_START, variant: str = \"R1\") -> NKFit:\n97:     df = build_dataset(panel, est_start)\n98:     d = df.copy()\n99:     for col in [\"gap\", \"pi\", \"r\", \"dfx\", \"pi12\", \"selic\"]:\n100:         d[f\"{col}_1\"] = d[col].shift(1)\n101:         d[f\"{col}_2\"] = d[col].shift(2)\n102: \n103:     # --- IS curve -----------------------------------------------------------\n104:     is_df = d.dropna(subset=[\"gap\", \"gap_1\", \"gap_2\", \"r_1\"]).copy()\n105:     is_df[\"rr\"] = is_df[\"r_1\"] - RSTAR\n106:     cols_is = [\"gap_1\", \"gap_2\", \"rr\"] + _covid_terms(is_df)\n107:     X_is = is_df[cols_is]\n108:     is_res = _ols(is_df[\"gap\"], X_is)\n109:     is_resid = pd.Series(is_res.resid.to_numpy(), index=is_df.index)\n110: \n111:     # --- Hybrid NKPC with long-run neutrality imposed -----------------------\n112:     # pi_t - pi_e_t = c + b1 (pi_{t-1} - pi_e_t) + b2 (pi_{t-2} - pi_e_t)\n113:     #                 + b4 gap_{t-1} + b5 dfx_{t-1} + e\n114:     nk_df = d.dropna(subset=[\"pi\", \"pi_1\", \"pi_2\", \"pi_e\", \"gap_1\", \"dfx_1\"]).copy()\n115:     nk_df[\"pi_rel\"] = nk_df[\"pi\"] - nk_df[\"pi_e\"]\n116:     nk_df[\"pi1_rel\"] = nk_df[\"pi_1\"] - nk_df[\"pi_e\"]\n117:     nk_df[\"pi2_rel\"] = nk_df[\"pi_2\"] - nk_df[\"pi_e\"]\n118:     cols_nk = [\"pi1_rel\", \"pi2_rel\", \"gap_1\", \"dfx_1\"] + _covid_terms(nk_df)\n119:     X_nk = nk_df[cols_nk]\n120:     nk_res = _ols(nk_df[\"pi_rel\"], X_nk)\n121:     nk_resid = pd.Series(nk_res.resid.to_numpy(), index=nk_df.index)\n122:     nk_params = nk_res.params.copy()\n123:     nk_params[\"pi_e\"] = 1.0 - nk_params[\"pi1_rel\"] - nk_params[\"pi2_rel\"]\n124: \n125:     # --- Taylor rule with neutral real rate imposed -------------------------\n126:     # i_t - target_t - rstar = rho (i_{t-1} - target_t - rstar)\n127:     #                          + g1 (pi12_{t-1} - target_t) + g2 gap_{t-1} + e\n128:     # R3 replaces lagged inflation with the survey 12m expectation.\n129:     tr_df = d.dropna(subset=[\"selic\", \"selic_1\", \"gap_1\"]).copy()\n130:     if variant == \"R3\":\n131:         tr_df = tr_df.dropna(subset=[\"focus\"])\n132:         tr_df[\"anchor_gap\"] = tr_df[\"focus\"] - tr_df[\"target\"]\n133:         anchor_col = \"anchor_gap\"\n134:     else:\n135:         tr_df = tr_df.dropna(subset=[\"pi12_1\"])\n136:         tr_df[\"anchor_gap\"] = tr_df[\"pi12_1\"] - tr_df[\"target\"]\n137:         anchor_col = \"anchor_gap\"\n138:     tr_df[\"lhs\"] = tr_df[\"selic\"] - tr_df[\"target\"] - RSTAR\n139:     tr_df[\"i_lag\"] = tr_df[\"selic_1\"] - tr_df[\"target\"] - RSTAR\n140:     cols_tr = [\"i_lag\", anchor_col, \"gap_1\"]\n141:     tr_res = _ols(tr_df[\"lhs\"], tr_df[cols_tr], constant=False)\n142:     tr_resid = pd.Series(tr_res.resid.to_numpy(), index=tr_df.index)\n143:     tr_params = tr_res.params.copy()\n144:     tr_params[\"const\"] = 0.0\n145:     tr_params = tr_params.rename({anchor_col: \"pi_gap\"})\n146:     tr_tstats = tr_res.tvalues.rename({anchor_col: \"pi_gap\"})\n147: \n148:     def cond(X: pd.DataFrame, constant: bool = True) -> float:\n149:         x = (sm.add_constant(X) if constant else X).to_numpy()\n150:         return float(np.linalg.cond(x))\n151: \n152:     return NKFit(\n153:         is_params=is_res.params,\n154:         nkpc_params=nk_params,\n155:         taylor_params=tr_params,\n156:         is_tstats=is_res.tvalues,\n157:         nkpc_tstats=nk_res.tvalues,\n158:         taylor_tstats=tr_tstats,\n159:         is_resid=is_resid,\n160:         nkpc_resid=nk_resid,\n161:         taylor_resid=tr_resid,\n162:         is_rsquared=float(is_res.rsquared),\n163:         nkpc_rsquared=float(nk_res.rsquared),\n164:         taylor_rsquared=float(tr_res.rsquared),\n165:         data=df,\n166:         gap=df[\"gap\"],\n167:         trend=df[\"trend_log\"],\n168:         condition_is=cond(X_is),\n169:         condition_nkpc=cond(X_nk),\n170:         condition_taylor=cond(tr_df[cols_tr], constant=False),\n171:         nobs={\n172:             \"is\": int(is_res.nobs),\n173:             \"nkpc\": int(nk_res.nobs),\n174:             \"taylor\": int(tr_res.nobs),\n175:         },\n176:     )\n177: \n178: \n179: def _coef(params: pd.Series, name: str) -> float:\n180:     return float(params[name]) if name in params.index else 0.0\n181: \n182: \n183: def _forecast_paths(panel: Panel, fit: NKFit, variant: str = \"R1\", steps: int = 14):\n184:     m0 = month_of(panel.origin)\n185:     pi_hist = panel.monthly(\"ipca_m\")\n186:     selic_hist = panel.monthly(\"selic_target\")\n187:     focus_hist = panel.monthly(\"focus_ipca_12m\")\n188:     ibc_hist = panel.monthly(\"ibc_br\")\n189:     fx_hist = panel.monthly(\"fx_usdbrl\")\n190: \n191:     gap = fit.gap\n192:     if gap.index[-1] != m0 - 1:\n193:         raise ValueError(f\"NK gap ends {gap.index[-1]}, expected {m0 - 1}\")\n194: \n195:     i_M = float(selic_hist.loc[m0])\n196:     focus_M = float(focus_hist.loc[m0])\n197:     pi_e_m = ((1 + focus_M / 100) ** (1 / 12) - 1) * 100\n198: \n199:     b_is = fit.is_params\n200:     b_nk = fit.nkpc_params\n201:     b_tr = fit.taylor_params\n202: \n203:     path_pi: dict[pd.Period, float] = {\n204:         m0 - 1: float(pi_hist.loc[m0 - 1]),\n205:         m0 - 2: float(pi_hist.loc[m0 - 2]),\n206:     }\n207:     path_gap: dict[pd.Period, float] = {\n208:         m0 - 1: float(gap.loc[m0 - 1]),\n209:         m0 - 2: float(gap.loc[m0 - 2]),\n210:     }\n211:     path_i: dict[pd.Period, float] = {m0: i_M}\n212: \n213:     dfx_minus1 = float(100 * np.log(fx_hist.loc[m0 - 1] / fx_hist.loc[m0 - 2]))\n214:     # A pre-COVID origin cannot know the pandemic regime. The dummy is only used\n215:     # for forecast months when the origin is already inside the COVID window.\n216:     origin_has_covid = panel.origin >= COVID_START.start_time.date()\n217: \n218:     for j in range(0, steps + 1):\n219:         t = m0 + j\n220:         covid_term = covid_flag(t) if origin_has_covid else 0.0\n221:         gap_1, gap_2 = path_gap[t - 1], path_gap[t - 2]\n222:         r_1 = (\n223:             float(selic_hist.loc[m0 - 1] - focus_hist.loc[m0 - 1])\n224:             if j == 0\n225:             else path_i[t - 1] - focus_M\n226:         )\n227:         path_gap[t] = float(\n228:             _coef(b_is, \"const\")\n229:             + _coef(b_is, \"gap_1\") * gap_1\n230:             + _coef(b_is, \"gap_2\") * gap_2\n231:             + _coef(b_is, \"rr\") * (r_1 - RSTAR)\n232:             + _coef(b_is, \"covid\") * covid_term\n233:         )\n234: \n235:         pi_1, pi_2 = path_pi[t - 1], path_pi[t - 2]\n236:         dfx_1 = dfx_minus1 if j == 0 else 0.0\n237:         path_pi[t] = float(\n238:             _coef(b_nk, \"const\")\n239:             + _coef(b_nk, \"pi1_rel\") * pi_1\n240:             + _coef(b_nk, \"pi2_rel\") * pi_2\n241:             + _coef(b_nk, \"pi_e\") * pi_e_m\n242:             + _coef(b_nk, \"gap_1\") * gap_1\n243:             + _coef(b_nk, \"dfx_1\") * dfx_1\n244:             + _coef(b_nk, \"covid\") * covid_term\n245:         )\n246: \n247:         if j > 0:\n248:             full_pi = pd.concat([pi_hist, pd.Series(path_pi).sort_index()])\n249:             full_pi = full_pi[~full_pi.index.duplicated(keep=\"last\")].sort_index()\n250:             window = pd.period_range(t - 12, t - 1, freq=\"M\")\n251:             pi12_prev = compound(full_pi.loc[window])\n252:             target_t = target_for(t.start_time.date())\n253:             anchor = focus_M if variant == \"R3\" else pi12_prev\n254:             path_i[t] = float(\n255:                 target_t\n256:                 + RSTAR\n257:                 + _coef(b_tr, \"i_lag\") * (path_i[t - 1] - target_t - RSTAR)\n258:                 + _coef(b_tr, \"pi_gap\") * (anchor - target_t)\n259:                 + _coef(b_tr, \"gap_1\") * path_gap[t - 1]\n260:             )\n261: \n262:     pi_path = pd.Series(path_pi).sort_index()\n263:     gap_path = pd.Series(path_gap).sort_index()\n264:     i_path = pd.Series(path_i).sort_index()\n265: \n266:     # --- GDP bridge ---------------------------------------------------------\n267:     if variant in {\"R2\", \"R3\"}:\n268:         growth = (100 * np.log(ibc_hist).diff()).dropna()\n269:         p_g, beta_g = fit_ar(growth.to_numpy(), 3)\n270:         gfc = forecast_ar(growth.to_numpy(), p_g, beta_g, steps + 1)\n271:         levels: dict[pd.Period, float] = {m0 - 1: float(ibc_hist.loc[m0 - 1])}\n272:         for j, g in enumerate(gfc):\n273:             t = m0 + j\n274:             levels[t] = levels[t - 1] * np.exp(g / 100.0)\n275:     else:\n276:         trend = fit.trend\n277:         g_trend = float(np.mean(np.diff(trend.to_numpy())[-12:]))\n278:         levels = {m0 - 1: float(ibc_hist.loc[m0 - 1])}\n279:         for j in range(0, steps + 1):\n280:             t = m0 + j\n281:             levels[t] = levels[t - 1] * np.exp(\n282:                 g_trend + (gap_path[t] - gap_path[t - 1]) / 100.0\n283:             )\n284: \n285:     q0 = quarter_of(panel.origin)\n286: \n287:     def quarter_ibc(q: pd.Period) -> float:\n288:         months = pd.period_range(q.start_time, q.end_time, freq=\"M\")\n289:         vals = []\n290:         for m in months:\n291:             vals.append(\n292:                 float(ibc_hist.loc[m]) if m <= m0 - 1 else float(levels[m])\n293:             )\n294:         return float(np.mean(vals))\n295: \n296:     qlevels = {q: quarter_ibc(q) for q in pd.period_range(q0 - 3, q0 + 4, freq=\"Q\")}\n297:     ibc_qq = {\n298:         q: 100 * np.log(qlevels[q] / qlevels[q - 1])\n299:         for q in pd.period_range(q0 - 2, q0 + 4, freq=\"Q\")\n300:     }\n301: \n302:     ibc_q = ibc_hist.groupby(ibc_hist.index.asfreq(\"Q\")).mean()\n303:     counts = ibc_hist.groupby(ibc_hist.index.asfreq(\"Q\")).count()\n304:     ibc_q = ibc_q[counts == 3]\n305:     ibc_q_qq = 100 * np.log(ibc_q).diff()\n306:     gdp = panel.quarterly(\"gdp_qq\")\n307:     bridge = pd.concat([gdp.rename(\"gdp\"), ibc_q_qq.rename(\"ibc\")], axis=1, join=\"inner\")\n308:     bridge[\"ibc_lag\"] = bridge[\"ibc\"].shift(1)\n309:     bridge = bridge.dropna()\n310:     bridge = bridge[bridge.index >= pd.Period(ESTIMATION_START, \"Q\")]\n311:     if len(bridge) < 20:\n312:         raise ValueError(\"NK bridge: insufficient history\")\n313:     Xb = np.column_stack(\n314:         [np.ones(len(bridge)), bridge[\"ibc\"].to_numpy(), bridge[\"ibc_lag\"].to_numpy()]\n315:     )\n316:     beta, *_ = np.linalg.lstsq(Xb, bridge[\"gdp\"].to_numpy(), rcond=None)\n317: \n318:     gdp_fc = {\n319:         h: float(\n320:             beta[0] + beta[1] * ibc_qq[q0 + h] + beta[2] * ibc_qq[q0 + h - 1]\n321:         )\n322:         for h in range(5)\n323:     }\n324: \n325:     return pi_path, i_path, gap_path, pd.Series(gdp_fc), focus_M\n326: \n327: \n328: class NewKeynesian:\n329:     model_id = \"new_keynesian\"\n330:     school = \"new_keynesian\"\n331: \n332:     def __init__(self, est_start: str = NK_ESTIMATION_START, variant: str = \"R1\"):\n333:         if variant not in {\"R1\", \"R2\", \"R3\"}:\n334:             raise ValueError(f\"unknown NK variant {variant}\")\n335:         self.est_start = est_start\n336:         self.variant = variant\n337:         self.fit: NKFit | None = None\n338: \n339:     def forecast(self, panel: Panel) -> list[Forecast]:\n340:         self.fit = estimate(panel, self.est_start, self.variant)\n341:         pi_path, i_path, gap_path, gdp_fc, _ = _forecast_paths(\n342:             panel, self.fit, self.variant\n343:         )\n344: \n345:         pi_hist = panel.monthly(\"ipca_m\")\n346:         gdp = panel.quarterly(\"gdp_qq\")\n347:         selic = panel.monthly(\"selic_target\")\n348: \n349:         rows = ipca_rows(pi_path, pi_hist, panel.origin)\n350:         gdp_forecasts = gdp_rows(gdp_fc.to_dict(), panel.origin, float(gdp.iloc[-1]))\n351:         for row in gdp_forecasts:\n352:             row.notes = \"satellite_bridge; shared with ibc_bridge\"\n353:         rows += gdp_forecasts\n354:         rows += selic_rows(i_path, panel.origin, float(selic.iloc[-1]))\n355:         return validate_rows(rows, self.model_id)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/workspace/in/src/models/new_keynesian.py\"}"},"time":{"start":1795490548234,"end":1795490548653}}}}
