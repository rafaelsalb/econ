{"type":"tool_use","timestamp":1795490615859,"sessionID":"ses_df46cae64ffeenRtbOVhMS6Q6Y","part":{"partID":"prt_20b94914c0015c3eYGGoDgPoHQ","sessionID":"ses_df46cae64ffeenRtbOVhMS6Q6Y","messageID":"msg_20b938bc5001keMG4ZKT6q0IA3","type":"tool","id":"call_0a5287dcb0254ab1a12b7b78","tool":"read","state":{"status":"completed","input":{"path":"/workspace/in/src/critics.py"},"output":"Read file /workspace/in/src/critics.py, lines 1-303\n1: from __future__ import annotations\n2: \n3: import math\n4: \n5: import numpy as np\n6: import pandas as pd\n7: \n8: from .diagnostics import Defect\n9: \n10: \n11: def _num(params: dict, block: str, key: str) -> float:\n12:     return float(params.get(block, {}).get(key, float(\"nan\")))\n13: \n14: \n15: def _sig(params: dict, key: str, block: str = \"nkpc\") -> float:\n16:     return _num(params, block, key)\n17: \n18: \n19: def check_refutations(diag: dict, card: dict) -> list[Defect]:\n20:     \"\"\"Evaluate the card's machine-readable refutation tests.\n21: \n22:     A test states the condition the estimate must satisfy to be admissible.\n23:     If the condition fails, the model's own pre-registered falsification rule\n24:     fires and the returned defect carries the declared severity.\n25:     \"\"\"\n26:     out: list[Defect] = []\n27:     for test in card.get(\"refutation_tests\", []) or []:\n28:         block = test[\"block\"]\n29:         key = test[\"key\"]\n30:         stat = test.get(\"stat\", \"coef\")\n31:         source = diag[\"tstats\"] if stat == \"tstat\" else diag[\"params\"]\n32:         val = float(source.get(block, {}).get(key, float(\"nan\")))\n33:         op = test[\"op\"]\n34:         threshold = float(test[\"threshold\"])\n35:         ok = False\n36:         if math.isfinite(val):\n37:             if op == \"gt\":\n38:                 ok = val > threshold\n39:             elif op == \"lt\":\n40:                 ok = val < threshold\n41:             elif op == \"abs_ge\":\n42:                 ok = abs(val) >= threshold\n43:         if not ok:\n44:             out.append(\n45:                 Defect(\n46:                     test.get(\"code\", \"D1\"),\n47:                     test.get(\"severity\", \"high\"),\n48:                     test[\"message\"],\n49:                     {\n50:                         \"test\": test.get(\"id\", \"\"),\n51:                         \"block\": block,\n52:                         \"key\": key,\n53:                         \"stat\": stat,\n54:                         \"value\": val,\n55:                         \"threshold\": threshold,\n56:                     },\n57:                 )\n58:             )\n59:     return out\n60: \n61: \n62: def fidelity_critique(diag: dict, irf: dict, card: dict) -> list[Defect]:\n63:     p = diag[\"params\"]\n64:     t = diag[\"tstats\"]\n65:     defects: list[Defect] = []\n66: \n67:     checks = [\n68:         (\"rr\", \"is\", -1, \"Real-rate coefficient in the IS curve must be negative\"),\n69:         (\"gap_1\", \"nkpc\", 1, \"Output-gap coefficient in the NKPC must be positive\"),\n70:         (\"i_lag\", \"taylor\", 1, \"Policy smoothing coefficient must lie in (0,1)\"),\n71:         (\"pi_gap\", \"taylor\", 1, \"Inflation response in the Taylor rule must be positive\"),\n72:         (\"gap_1\", \"taylor\", 1, \"Gap response in the Taylor rule must be positive\"),\n73:     ]\n74:     for key, block, expected, msg in checks:\n75:         val = _num(p, block, key)\n76:         if not math.isfinite(val):\n77:             defects.append(Defect(\"D7\", \"high\", f\"{msg}; coefficient missing\", {\"block\": block, \"key\": key}))\n78:             continue\n79:         if expected > 0 and val <= 0:\n80:             defects.append(Defect(\"D7\", \"high\", msg, {\"block\": block, \"key\": key, \"value\": val}))\n81:         if expected < 0 and val >= 0:\n82:             defects.append(Defect(\"D7\", \"high\", msg, {\"block\": block, \"key\": key, \"value\": val}))\n83: \n84:     rho = _num(p, \"taylor\", \"i_lag\")\n85:     if not (0 < rho < 1):\n86:         defects.append(Defect(\"D7\", \"high\", \"Taylor-rule smoothing outside (0,1)\", {\"rho\": rho}))\n87:     elif rho > 0.98:\n88:         defects.append(\n89:             Defect(\n90:                 \"D7\",\n91:                 \"medium\",\n92:                 \"Policy inertia is near a unit root; the rate path may respond too slowly\",\n93:                 {\"rho\": rho},\n94:             )\n95:         )\n96: \n97:     # Long-run neutrality is imposed by construction; verify the implemented sum.\n98:     b1, b2, b3 = _sig(p, \"pi1_rel\"), _sig(p, \"pi2_rel\"), _sig(p, \"pi_e\")\n99:     if abs((b1 + b2 + b3) - 1.0) > 1e-6:\n100:         defects.append(\n101:             Defect(\"D2\", \"high\", \"NKPC long-run neutrality violated\", {\"sum\": b1 + b2 + b3})\n102:         )\n103: \n104:     gap_coef = _sig(p, \"gap_1\")\n105:     if math.isfinite(gap_coef) and 0 < gap_coef < 0.02:\n106:         defects.append(\n107:             Defect(\n108:                 \"D7\",\n109:                 \"medium\",\n110:                 \"Output-gap transmission is economically negligible (<0.02pp monthly inflation per 1pp gap)\",\n111:                 {\"gap_coef\": gap_coef},\n112:             )\n113:         )\n114: \n115:     fx_coef = _sig(p, \"dfx_1\")\n116:     # The sign restriction is evaluated by the card's refutation tests below.\n117:     # Keep a fallback for cards that predate the machine-readable tests.\n118:     if not card.get(\"refutation_tests\") and math.isfinite(fx_coef) and fx_coef <= 0:\n119:         defects.append(\n120:             Defect(\n121:                 \"D7\",\n122:                 \"high\",\n123:                 \"FX pass-through coefficient is non-positive; the external channel is not identified\",\n124:                 {\"fx_coef\": fx_coef},\n125:             )\n126:         )\n127: \n128:     for key, block, label in [\n129:         (\"rr\", \"is\", \"real-rate\"),\n130:         (\"pi_gap\", \"taylor\", \"inflation-response\"),\n131:     ]:\n132:         tval = _num(t, block, key)\n133:         if math.isfinite(tval) and abs(tval) < 1.65:\n134:             defects.append(\n135:                 Defect(\n136:                     \"D1\",\n137:                     \"medium\",\n138:                     f\"{label} coefficient is not precisely estimated (|t| < 1.65)\",\n139:                     {\"block\": block, \"key\": key, \"tstat\": tval},\n140:                 )\n141:             )\n142: \n143:     if card.get(\"observables\", {}).get(\"expectations\", {}).get(\"series\") != \"focus_ipca_12m\":\n144:         defects.append(\n145:             Defect(\"D1\", \"high\", \"Expectations are not mapped to the survey series declared in the card\")\n146:         )\n147: \n148:     for name, sign in irf.items():\n149:         if name == \"real_rate_to_gap\" and sign >= 0:\n150:             defects.append(Defect(\"D7\", \"high\", \"Monetary transmission sign wrong: real rate does not lower the gap\"))\n151:         if name == \"gap_to_inflation\" and sign <= 0:\n152:             defects.append(Defect(\"D7\", \"high\", \"Monetary transmission sign wrong: gap does not raise inflation\"))\n153: \n154:     defects.extend(check_refutations(diag, card))\n155:     return defects\n156: \n157: \n158: def adequacy_critique(\n159:     diag: dict,\n160:     metrics: pd.DataFrame,\n161:     stability: dict | None = None,\n162:     card: dict | None = None,\n163: ) -> list[Defect]:\n164:     defects: list[Defect] = []\n165:     model_id = \"new_keynesian\"\n166: \n167:     if diag.get(\"leak_ok\") is False:\n168:         defects.append(\n169:             Defect(\"D3\", \"high\", \"As-of slice contains observations released after the origin\",\n170:                    {\"max_release\": diag.get(\"max_release\")})\n171:         )\n172: \n173:     if card:\n174:         declared = card.get(\"estimation\", {}).get(\"start\")\n175:         if declared:\n176:             declared_start = pd.Period(str(declared), \"M\")\n177:             actual_start = pd.Period(str(diag[\"sample_start\"]), \"M\")\n178:             if actual_start < declared_start:\n179:                 defects.append(\n180:                     Defect(\n181:                         \"D3\",\n182:                         \"high\",\n183:                         f\"Estimation sample starts {actual_start}, before the card's declared {declared_start}\",\n184:                         {\"card_start\": str(declared_start), \"actual_start\": str(actual_start)},\n185:                     )\n186:                 )\n187: \n188:     for block, pval in diag[\"ljung_box_p\"].items():\n189:         if not math.isfinite(pval):\n190:             continue\n191:         if pval < 0.01:\n192:             defects.append(\n193:                 Defect(\"D4\", \"medium\", f\"Residual autocorrelation in {block} equation (Ljung-Box p={pval:.4f})\",\n194:                        {\"equation\": block, \"pvalue\": pval})\n195:             )\n196:         elif pval < 0.05:\n197:             defects.append(\n198:                 Defect(\"D4\", \"low\", f\"Weak residual autocorrelation in {block} equation (p={pval:.4f})\",\n199:                        {\"equation\": block, \"pvalue\": pval})\n200:             )\n201: \n202:     for block, cond in diag[\"condition\"].items():\n203:         if cond > 1000:\n204:             defects.append(Defect(\"D4\", \"high\", f\"Severe multicollinearity in {block} (cond={cond:.1f})\",\n205:                                   {\"equation\": block, \"condition\": cond}))\n206:         elif cond > 100:\n207:             defects.append(Defect(\"D4\", \"medium\", f\"Multicollinearity in {block} (cond={cond:.1f})\",\n208:                                   {\"equation\": block, \"condition\": cond}))\n209: \n210:     for block, r2 in diag[\"rsquared\"].items():\n211:         if block == \"nkpc\" and r2 < 0.10:\n212:             defects.append(Defect(\"D4\", \"low\", f\"NKPC fit is weak (R2={r2:.3f})\", {\"r2\": r2}))\n213: \n214:     if stability:\n215:         for block, info in stability.items():\n216:             flips = info.get(\"_sign_flips\", 0)\n217:             if flips >= 2:\n218:                 defects.append(Defect(\"D4\", \"medium\", f\"{flips} sign flips in {block} across sub-samples\",\n219:                                       {\"equation\": block, \"flips\": flips}))\n220:             elif flips == 1:\n221:                 defects.append(Defect(\"D4\", \"low\", f\"One sign flip in {block} across sub-samples\",\n222:                                       {\"equation\": block, \"flips\": flips}))\n223: \n224:     if card:\n225:         validation_end = card.get(\"validation_end\")\n226:         if validation_end and \"max_ref_date\" in metrics.columns:\n227:             latest = pd.to_datetime(metrics[\"max_ref_date\"]).max()\n228:             if pd.notna(latest) and latest > pd.Timestamp(validation_end):\n229:                 defects.append(\n230:                     Defect(\n231:                         \"D3\",\n232:                         \"high\",\n233:                         \"Validation targets extend beyond the declared validation end; the lockbox is contaminated\",\n234:                         {\"max_ref_date\": str(latest.date()), \"validation_end\": str(validation_end)},\n235:                     )\n236:                 )\n237: \n238:     sub = metrics[(metrics[\"model_id\"] == model_id) & (metrics[\"primary\"])]\n239:     for _, row in sub.iterrows():\n240:         if bool(row.get(\"satellite\", False)):\n241:             continue\n242:         target = row[\"target\"]\n243:         severity = \"high\" if target == \"ipca_12m\" else \"medium\"\n244:         if pd.notna(row[\"theil_u\"]) and row[\"theil_u\"] > 1.05:\n245:             defects.append(\n246:                 Defect(\"D5\", severity, f\"{target} h={int(row['horizon'])} loses to random walk (Theil U={row['theil_u']:.3f})\",\n247:                     