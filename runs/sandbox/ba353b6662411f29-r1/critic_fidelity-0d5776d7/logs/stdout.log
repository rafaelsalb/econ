{"type":"tool_use","timestamp":1795490628755,"sessionID":"ses_df46cae64ffeenRtbOVhMS6Q6Y","part":{"partID":"prt_20b94c404001cItvMXiCqr6TWE","sessionID":"ses_df46cae64ffeenRtbOVhMS6Q6Y","messageID":"msg_20b94a97e001QvinxXfnAQQ7os","type":"tool","id":"call_a0842ca8dbba4c839452fa10","tool":"read","state":{"status":"completed","input":{"path":"/workspace/in/src/evaluate.py"},"output":"Read file /workspace/in/src/evaluate.py, lines 1-310\n1: from __future__ import annotations\n2: \n3: from datetime import date\n4: \n5: import numpy as np\n6: import pandas as pd\n7: import statsmodels.api as sm\n8: from scipy import stats\n9: \n10: from . import config\n11: from .config import EPISODES\n12: from .targets import (\n13:     PRIMARY_HORIZONS,\n14:     compound,\n15:     monthly_inflation_series,\n16:     quarterly_gdp_series,\n17:     selic_monthly_series,\n18: )\n19: \n20: \n21: def realized_table(obs: pd.DataFrame) -> pd.DataFrame:\n22:     rows = []\n23:     pi = monthly_inflation_series(obs)\n24:     for m, v in pi.items():\n25:         rows.append({\"target\": \"ipca_m\", \"ref_date\": m.end_time.date(), \"realized\": float(v)})\n26:     for m in pi.index:\n27:         window = pd.period_range(m - 11, m, freq=\"M\")\n28:         if all(p in pi.index for p in window):\n29:             rows.append(\n30:                 {\n31:                     \"target\": \"ipca_12m\",\n32:                     \"ref_date\": m.end_time.date(),\n33:                     \"realized\": compound(pi.loc[window]),\n34:                 }\n35:             )\n36:     for q, v in quarterly_gdp_series(obs).items():\n37:         rows.append({\"target\": \"gdp_qq\", \"ref_date\": q.end_time.date(), \"realized\": float(v)})\n38:     for m, v in selic_monthly_series(obs).items():\n39:         rows.append({\"target\": \"selic\", \"ref_date\": m.end_time.date(), \"realized\": float(v)})\n40:     df = pd.DataFrame(rows)\n41:     df[\"ref_date\"] = pd.to_datetime(df[\"ref_date\"]).dt.date\n42:     return df\n43: \n44: \n45: def attach_realized(forecasts: pd.DataFrame, obs: pd.DataFrame) -> pd.DataFrame:\n46:     rt = realized_table(obs)\n47:     fc = forecasts.copy()\n48:     fc[\"ref_date\"] = pd.to_datetime(fc[\"ref_date\"]).dt.date\n49:     fc[\"origin_date\"] = pd.to_datetime(fc[\"origin_date\"]).dt.date\n50:     out = fc.merge(rt, on=[\"target\", \"ref_date\"], how=\"left\")\n51:     out[\"error\"] = out[\"point\"] - out[\"realized\"]\n52:     return out\n53: \n54: \n55: def dm_test(e1: np.ndarray, e2: np.ndarray, h: int) -> tuple[float, float]:\n56:     d = np.asarray(e1, float) ** 2 - np.asarray(e2, float) ** 2\n57:     n = len(d)\n58:     if n < 8:\n59:         return np.nan, np.nan\n60:     dbar = float(np.mean(d))\n61:     gamma0 = float(np.var(d, ddof=0))\n62:     L = max(h, 1)\n63:     var = gamma0\n64:     for j in range(1, L + 1):\n65:         if j >= n:\n66:             break\n67:         gj = float(np.mean((d[j:] - dbar) * (d[:-j] - dbar)))\n68:         var += 2.0 * (1.0 - j / (L + 1)) * gj\n69:     var /= n\n70:     if var <= 0:\n71:         return np.nan, np.nan\n72:     stat = dbar / np.sqrt(var)\n73:     if h > 0:\n74:         stat *= np.sqrt((n + 1 - 2 * h + h * (h - 1) / n) / n)\n75:     p = 2 * (1 - stats.t.cdf(abs(stat), df=n - 1))\n76:     return float(stat), float(p)\n77: \n78: \n79: def mz_test(y: np.ndarray, fc: np.ndarray, h: int) -> dict:\n80:     y = np.asarray(y, float)\n81:     fc = np.asarray(fc, float)\n82:     nan = {\n83:         \"mz_slope\": np.nan,\n84:         \"mz_slope_p\": np.nan,\n85:         \"mz_intercept\": np.nan,\n86:         \"mz_intercept_p\": np.nan,\n87:         \"mz_r2\": np.nan,\n88:     }\n89:     if len(y) < 8 or np.std(fc) < 1e-10 or np.std(y) < 1e-10:\n90:         return nan\n91:     X = sm.add_constant(fc)\n92:     if np.linalg.matrix_rank(X) < 2:\n93:         return nan\n94:     model = sm.OLS(y, X).fit(\n95:         cov_type=\"HAC\", cov_kwds={\"maxlags\": max(h, 1)}, use_t=True\n96:     )\n97:     b = float(model.params[1])\n98:     se = float(model.bse[1])\n99:     a = float(model.params[0])\n100:     p_b1 = 2 * (1 - stats.t.cdf(abs((b - 1) / se), df=int(model.df_resid)))\n101:     p_a0 = 2 * (1 - stats.t.cdf(abs(a / float(model.bse[0])), df=int(model.df_resid)))\n102:     return {\n103:         \"mz_slope\": b,\n104:         \"mz_slope_p\": float(p_b1),\n105:         \"mz_intercept\": a,\n106:         \"mz_intercept_p\": float(p_a0),\n107:         \"mz_r2\": float(model.rsquared),\n108:     }\n109: \n110: \n111: def evaluate(forecasts: pd.DataFrame, obs: pd.DataFrame) -> pd.DataFrame:\n112:     fc = attach_realized(forecasts, obs)\n113:     fc = fc.dropna(subset=[\"realized\", \"point\"])\n114:     fc = fc[~((fc[\"target\"] == \"selic\") & (fc[\"horizon\"] == 0))]\n115:     rw = fc[fc[\"model_id\"] == \"random_walk\"]\n116:     focus = fc[fc[\"model_id\"] == \"focus_consensus\"]\n117: \n118:     out = []\n119:     groups = fc.groupby([\"model_id\", \"school\", \"target\", \"horizon\"], dropna=False)\n120:     for (model_id, school, target, horizon), g in groups:\n121:         g = g.sort_values(\"origin_date\")\n122:         err = g[\"error\"].to_numpy()\n123:         y = g[\"realized\"].to_numpy()\n124:         p = g[\"point\"].to_numpy()\n125:         n = len(g)\n126:         rmse = float(np.sqrt(np.mean(err**2)))\n127:         mae = float(np.mean(np.abs(err)))\n128:         bias = float(np.mean(err))\n129:         satellite = bool(\n130:             g[\"notes\"].fillna(\"\").astype(str).str.contains(\"satellite\").any()\n131:         )\n132: \n133:         rwg = rw[(rw[\"target\"] == target) & (rw[\"horizon\"] == horizon)]\n134:         joint = g.merge(\n135:             rwg[[\"origin_date\", \"error\", \"point\", \"realized\"]],\n136:             on=\"origin_date\",\n137:             suffixes=(\"\", \"_rw\"),\n138:             how=\"inner\",\n139:         )\n140:         if len(joint) >= 8:\n141:             theil = float(\n142:                 np.sqrt(np.mean(joint[\"error\"] ** 2))\n143:                 / np.sqrt(np.mean(joint[\"error_rw\"] ** 2))\n144:             )\n145:             dm_stat, dm_p = dm_test(\n146:                 joint[\"error\"].to_numpy(), joint[\"error_rw\"].to_numpy(), int(horizon)\n147:             )\n148:         else:\n149:             theil, dm_stat, dm_p = np.nan, np.nan, np.nan\n150: \n151:         fg = focus[(focus[\"target\"] == target) & (focus[\"horizon\"] == horizon)]\n152:         jf = g.merge(\n153:             fg[[\"origin_date\", \"error\"]],\n154:             on=\"origin_date\",\n155:             suffixes=(\"\", \"_focus\"),\n156:             how=\"inner\",\n157:         )\n158:         if len(jf) >= 8 and model_id != \"focus_consensus\":\n159:             rmse_joint = float(np.sqrt(np.mean(jf[\"error\"] ** 2)))\n160:             rmse_focus = float(np.sqrt(np.mean(jf[\"error_focus\"] ** 2)))\n161:             focus_ratio = rmse_joint / rmse_focus if rmse_focus > 0 else np.nan\n162:             dm_focus_stat, dm_focus_p = dm_test(\n163:                 jf[\"error\"].to_numpy(), jf[\"error_focus\"].to_numpy(), int(horizon)\n164:             )\n165:         else:\n166:             focus_ratio, dm_focus_stat, dm_focus_p = np.nan, np.nan, np.nan\n167: \n168:         mz = mz_test(y, p, int(horizon))\n169:         dir_mask = g[\"anchor\"].notna()\n170:         if dir_mask.sum() > 0:\n171:             da = float(\n172:                 np.mean(\n173:                     np.sign(g.loc[dir_mask, \"point\"] - g.loc[dir_mask, \"anchor\"])\n174:                     == np.sign(g.loc[dir_mask, \"realized\"] - g.loc[dir_mask, \"anchor\"])\n175:                 )\n176:             )\n177:         else:\n178:             da = np.nan\n179: \n180:         out.append(\n181:             {\n182:                 \"model_id\": model_id,\n183:                 \"school\": school,\n184:                 \"target\": target,\n185:                 \"horizon\": int(horizon),\n186:                 \"n\": n,\n187:                 \"rmse\": rmse,\n188:                 \"mae\": mae,\n189:                 \"bias\": bias,\n190:                 \"theil_u\": theil,\n191:                 \"dm_stat\": dm_stat,\n192:                 \"dm_p\": dm_p,\n193:                 \"focus_ratio\": focus_ratio,\n194:                 \"dm_focus_stat\": dm_focus_stat,\n195:                 \"dm_focus_p\": dm_focus_p,\n196:                 **mz,\n197:                 \"direction\": da,\n198:                 \"satellite\": satellite,\n199:                 \"max_ref_date\": g[\"ref_date\"].max(),\n200:                 \"primary\": int(horizon) in PRIMARY_HORIZONS.get(target, []),\n201:                 \"first_origin\": g[\"origin_date\"].min(),\n202:                 \"last_origin\": g[\"origin_date\"].max(),\n203:             }\n204:         )\n205:     metrics = pd.DataFrame(out)\n206:     metrics[\"rank\"] = (\n207:         metrics.groupby([\"target\", \"horizon\"])[\"rmse\"].rank(method=\"min\").astype(\"Int64\")\n208:     )\n209:     return metrics.sort_values([\"target\", \"horizon\", \"rmse\"]).reset_index(drop=True)\n210: \n211: \n212: def episode_metrics(forecasts: pd.DataFrame, obs: pd.DataFrame) -> pd.DataFrame:\n213:     fc = attach_realized(forecasts, obs).dropna(subset=[\"realized\", \"point\"])\n214:     fc = fc[~((fc[\"target\"] == \"selic\") & (fc[\"horizon\"] == 0))]\n215:     rows = []\n216:     for name, (lo, hi) in EPISODES.items():\n217:         lo_d, hi_d = date.fromisoformat(lo), date.fromisoformat(hi)\n218:         sub = fc[(fc[\"origin_date\"] >= lo_d) & (fc[\"origin_date\"] <= hi_d)]\n219:         if sub.empty:\n220:             continue\n221:         rw = sub[sub[\"model_id\"] == \"random_walk\"]\n222:         for (model_id, target, horizon), g in sub.groupby(\n223:             [\"model_id\", \"target\", \"horizon\"]\n224:         ):\n225:             rmse = float(np.sqrt(np.mean(g[\"error\"] ** 2)))\n226:             rwg = rw[(rw[\"target\"] == target) & (rw[\"horizon\"] == horizon)]\n227:             joint = g.merge(rwg[[\"origin_date\", \"error\"]], on=\"origin_date\", suffixes=(\"\", \"_rw\"))\n228:             theil = (\n229:                 float(\n230:                     np.sqrt(np.mean(joint[\"error\"] ** 2))\n231:                     / np.sqrt(np.mean(joint[\"error_rw\"] ** 2))\n232:                 )\n233:                 if len(joint) >= 5\n234:                 else np.nan\n235:             )\n236:             rows.append(\n237:                 {\n238:                     \"episode\": name,\n239:                     \"model_id\": model_id,\n240:                     \"target\": target,\n241:                     \"horizon\": int(horizon),\n242:                     \"n\": len(g),\n243:                     \"rmse\": rmse,\n244:                     \"theil_u\": theil,\n245:                 }\n246:             )\n247:     return pd.DataFrame(rows)\n248: \n249: \n250: def write_outputs(metrics: pd.DataFrame, episodes: pd.DataFrame) -> None:\n251:     config.EVAL.mkdir(parents=True, exist_ok=True)\n252:     metrics.to_csv(config.EVAL / \"scoreboard.csv\", index=False)\n253:     episodes.to_csv(config.EVAL / \"episodes.csv\", index=False)\n254: \n255:     lines = [\"# Brazil macro model hub — scoreboard\", \"\"]\n256:     lines.append(f\"Generated from registry run(s). {len(metrics)} model-target-horizon rows.\")\n257:     lines.append(\"\")\n258:     for target in [\"ipca_m\", \"ipca_12m\", \"gdp_qq\", \"selic\"]:\n259:         sub = metrics[metrics[\"target\"] == target]\n260:         if sub.empty:\n261:             continue\n262:         lines.append(f\"## {target}\")\n263:         lines.append(\"\")\n264:         lines.append(\n265:             \"| model | h | n | RMSE | Theil U | DM p | MZ slope | MZ p(b=1) | Dir. |\"\n266:         )\n267:         lines.append(\"|---|---:|---:|---:|---:|---:|---:|---:|---:|\")\n268:         for _, r in sub.iterrows():\n269:             def fmt(v, d=3):\n270:                 return \"—\" if pd.isna(v) else f\"{v:.{d}f}\"\n271: \n272:             lines.append(\n273:                 f\"| {r['model_id']} | {int(r['horizon'])} | {int(r['n'])} | \"\n274:                 f\"{fmt(r['rmse'])} | {fmt(r['theil_u'])} | {fmt(r['dm_p'])} | \"\n275:                 f\"{fmt(r['mz_slope'])} | {fmt(r['mz_slope_p'])} | {fmt(r['direction'], 2)} |\"\n276:             )\n277:         lines.append(\"\")\n278: \n279:     if not episodes.empty:\n280:         lines.append(\"## Episode scorecard (RMSE / Theil U)\")\n281:         lines.append(\"\")\n282:         for ep in episodes[\"episode\"].unique():\n283:             sub = episodes[episodes[\"episode\"] == ep]\n284:             lines.append(f\"### {ep}\")\n285:             lines.append(\"\")\n286:             lines.append(\"| model | target | h | n | RMSE | Theil U |\")\n287:             lines.append(\"|---|---|---:|---:|---:|---:|\")\n288:             for _, r in sub.iterrows():\n289:                 trials = \"—\" if pd.isna(r[\"theil_u\"]) else f\"{r['theil_u']:.3f}\"\n290:                 lines.append(\n291:                     f\"| {r['model_id']} | {r['target']} | {int(r['horizon'])} | \"\n292:                     f\"{int(r['n'])} | {r['rmse']:.3f} | {trials} |\"\n293:                 )\n294:             lines.append(\"\")\n295: \n296:     (config.EVAL / \"scoreboard.md\").write_text(\"\\n\".join(lines))\n297: \n298: \n299: def summary_by_model(metrics: pd.DataFrame) -> pd.DataFrame:\n300:     sub = metrics[metrics[\"primary\"] & ~metrics[\"satellite\"]]\n301:     return (\n302:         sub.groupby([\"model_id\", \"school\"])\n303:         .agg(\n304:             mean_rank=(\"rank\", \"mean\"),\n305:             mean_theil=(\"theil_u\", \"mean\"),\n306:             n_cells=(\"rmse\", \"size\"),\n307:         )\n308:         .sort_values(\"mean_rank\")\n309:         .reset_index()\n310:     )","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /workspace/in/src/evaluate.py, lines 1-310\n1: from __future__ import annotations\n2: \n3: from datetime import date\n4: \n5: import numpy as np\n6: import pandas as pd\n7: import statsmodels.api as sm\n8: from scipy import stats\n9: \n10: from . import config\n11: from .config import EPISODES\n12: from .targets import (\n13:     PRIMARY_HORIZONS,\n14:     compound,\n15:     monthly_inflation_series,\n16:     quarterly_gdp_series,\n17:     selic_monthly_series,\n18: )\n19: \n20: \n21: def realized_table(obs: pd.DataFrame) -> pd.DataFrame:\n22:     rows = []\n23:     pi = monthly_inflation_series(obs)\n24:     for m, v in pi.items():\n25:         rows.append({\"target\": \"ipca_m\", \"ref_date\": m.end_time.date(), \"realized\": float(v)})\n26:     for m in pi.index:\n27:         window = pd.period_range(m - 11, m, freq=\"M\")\n28:         if all(p in pi.index for p in window):\n29:             rows.append(\n30:                 {\n31:                     \"target\": \"ipca_12m\",\n32:                     \"ref_date\": m.end_time.date(),\n33:                     \"realized\": compound(pi.loc[window]),\n34:                 }\n35:             )\n36:     for q, v in quarterly_gdp_series(obs).items():\n37:         rows.append({\"target\": \"gdp_qq\", \"ref_date\": q.end_time.date(), \"realized\": float(v)})\n38:     for m, v in selic_monthly_series(obs).items():\n39:         rows.append({\"target\": \"selic\", \"ref_date\": m.end_time.date(), \"realized\": float(v)})\n40:     df = pd.DataFrame(rows)\n41:     df[\"ref_date\"] = pd.to_datetime(df[\"ref_date\"]).dt.date\n42:     return df\n43: \n44: \n45: def attach_realized(forecasts: pd.DataFrame, obs: pd.DataFrame) -> pd.DataFrame:\n46:     rt = realized_table(obs)\n47:     fc = forecasts.copy()\n48:     fc[\"ref_date\"] = pd.to_datetime(fc[\"ref_date\"]).dt.date\n49:     fc[\"origin_date\"] = pd.to_datetime(fc[\"origin_date\"]).dt.date\n50:     out = fc.merge(rt, on=[\"target\", \"ref_date\"], how=\"left\")\n51:     out[\"error\"] = out[\"point\"] - out[\"realized\"]\n52:     return out\n53: \n54: \n55: def dm_test(e1: np.ndarray, e2: np.ndarray, h: int) -> tuple[float, float]:\n56:     d = np.asarray(e1, float) ** 2 - np.asarray(e2, float) ** 2\n57:     n = len(d)\n58:     if n < 8:\n59:         return np.nan, np.nan\n60:     dbar = float(np.mean(d))\n61:     gamma0 = float(np.var(d, ddof=0))\n62:     L = max(h, 1)\n63:     var = gamma0\n64:     for j in range(1, L + 1):\n65:         if j >= n:\n66:             break\n67:         gj = float(np.mean((d[j:] - dbar) * (d[:-j] - dbar)))\n68:         var += 2.0 * (1.0 - j / (L + 1)) * gj\n69:     var /= n\n70:     if var <= 0:\n71:         return np.nan, np.nan\n72:     stat = dbar / np.sqrt(var)\n73:     if h > 0:\n74:         stat *= np.sqrt((n + 1 - 2 * h + h * (h - 1) / n) / n)\n75:     p = 2 * (1 - stats.t.cdf(abs(stat), df=n - 1))\n76:     return float(stat), float(p)\n77: \n78: \n79: def mz_test(y: np.ndarray, fc: np.ndarray, h: int) -> dict:\n80:     y = np.asarray(y, float)\n81:     fc = np.asarray(fc, float)\n82:     nan = {\n83:         \"mz_slope\": np.nan,\n84:         \"mz_slope_p\": np.nan,\n85:         \"mz_intercept\": np.nan,\n86:         \"mz_intercept_p\": np.nan,\n87:         \"mz_r2\": np.nan,\n88:     }\n89:     if len(y) < 8 or np.std(fc) < 1e-10 or np.std(y) < 1e-10:\n90:         return nan\n91:     X = sm.add_constant(fc)\n92:     if np.linalg.matrix_rank(X) < 2:\n93:         return nan\n94:     model = sm.OLS(y, X).fit(\n95:         cov_type=\"HAC\", cov_kwds={\"maxlags\": max(h, 1)}, use_t=True\n96:     )\n97:     b = float(model.params[1])\n98:     se = float(model.bse[1])\n99:     a = float(model.params[0])\n100:     p_b1 = 2 * (1 - stats.t.cdf(abs((b - 1) / se), df=int(model.df_resid)))\n101:     p_a0 = 2 * (1 - stats.t.cdf(abs(a / float(model.bse[0])), df=int(model.df_resid)))\n102:     return {\n103:         \"mz_slope\": b,\n104:         \"mz_slope_p\": float(p_b1),\n105:         \"mz_intercept\": a,\n106:         \"mz_intercept_p\": float(p_a0),\n107:         \"mz_r2\": float(model.rsquared),\n108:     }\n109: \n110: \n111: def evaluate(forecasts: pd.DataFrame, obs: pd.DataFrame) -> pd.DataFrame:\n112:     fc = attach_realized(forecasts, obs)\n113:     fc = fc.dropna(subset=[\"realized\", \"point\"])\n114:     fc = fc[~((fc[\"target\"] == \"selic\") & (fc[\"horizon\"] == 0))]\n115:     rw = fc[fc[\"model_id\"] == \"random_walk\"]\n116:     focus = fc[fc[\"model_id\"] == \"focus_consensus\"]\n117: \n118:     out = []\n119:     groups = fc.groupby([\"model_id\", \"school\", \"target\", \"horizon\"], dropna=False)\n120:     for (model_id, school, target, horizon), g in groups:\n121:         g = g.sort_values(\"origin_date\")\n122:         err = g[\"error\"].to_numpy()\n123:         y = g[\"realized\"].to_numpy()\n124:         p = g[\"point\"].to_numpy()\n125:         n = len(g)\n126:         rmse = float(np.sqrt(np.mean(err**2)))\n127:         mae = float(np.mean(np.abs(err)))\n128:         bias = float(np.mean(err))\n129:         satellite = bool(\n130:             g[\"notes\"].fillna(\"\").astype(str).str.contains(\"satellite\").any()\n131:         )\n132: \n133:         rwg = rw[(rw[\"target\"] == target) & (rw[\"horizon\"] == horizon)]\n134:         joint = g.merge(\n135:             rwg[[\"origin_date\", \"error\", \"point\", \"realized\"]],\n136:             on=\"origin_date\",\n137:             suffixes=(\"\", \"_rw\"),\n138:             how=\"inner\",\n139:         )\n140:         if len(joint) >= 8:\n141:             theil = float(\n142:                 np.sqrt(np.mean(joint[\"error\"] ** 2))\n143:                 / np.sqrt(np.mean(joint[\"error_rw\"] ** 2))\n144:             )\n145:             dm_stat, dm_p = dm_test(\n146:                 joint[\"error\"].to_numpy(), joint[\"error_rw\"].to_numpy(), int(horizon)\n147:             )\n148:         else:\n149:             theil, dm_stat, dm_p = np.nan, np.nan, np.nan\n150: \n151:         fg = focus[(focus[\"target\"] == target) & (focus[\"